import time
import uuid
import webbrowser
from pathlib import Path
from urllib.parse import quote, urlencode, urlparse

VERSION = "1.23.0"


def _platform_token():
    system = platform.system() or sys.platform
    machine = platform.machine()
    release = platform.release()
    return "; ".join(part for part in [system, release, machine] if part)


def _client_token():
    """Identify the host environment for the User-Agent comment — an explicit
    ASTRIA_CLIENT override, else the generic AI_AGENT marker, else Claude Code."""
    val = (os.environ.get("ASTRIA_CLIENT")
           or os.environ.get("AI_AGENT")
           or ("claude-code" if os.environ.get("CLAUDECODE") else None))
    if not val:
        return None
    return "".join(c for c in val if c.isalnum() or c in " ._/-")[:80]


def _user_agent():
    comment = "; ".join(part for part in [
        _platform_token(),
        f"Python/{platform.python_version()}",
        _client_token(),
    ] if part)
    return f"astria-cli/{VERSION} ({comment})"


