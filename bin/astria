JSON_ARGUMENT_SCHEMAS = {
    "sources": {"type": "array", "items": {"type": "object", "properties": {
        "provider": {"type": "string"}, "account_key": {"type": "string"},
        "resource_type": {"type": "string"}, "external_id": {"type": "string"},
        "metadata": {"type": "object", "additionalProperties": True}},
        "required": ["provider", "account_key", "resource_type", "external_id", "metadata"], "additionalProperties": False}},
    "tune_replacements": {"type": "object", "propertyNames": {"pattern": "^[1-9][0-9]*$"},
        "additionalProperties": {"type": "array", "minItems": 1,
            "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}}},
}


def validate_argument(schema, value):
    kind = schema["type"]
    if kind == "string":
        return (isinstance(value, str) and len(value) >= schema.get("minLength", 0)
            and ("pattern" not in schema or re.fullmatch(schema["pattern"], value) is not None)
            and ("enum" not in schema or value in schema["enum"]))
    if kind == "boolean":
        return isinstance(value, bool)
    if kind == "array":
        return (isinstance(value, list) and len(value) >= schema.get("minItems", 0)
            and all(validate_argument(schema["items"], item) for item in value))
    if kind == "object":
        if not isinstance(value, dict) or not set(schema.get("required", [])).issubset(value):
            return False
        properties = schema.get("properties", {})
        extra = schema.get("additionalProperties", True)
        for key, item in value.items():
            if "propertyNames" in schema and re.fullmatch(schema["propertyNames"]["pattern"], key) is None:
                return False
            rule = properties.get(key, extra)
            if rule is False or (isinstance(rule, dict) and not validate_argument(rule, item)):
                return False
        return True
    raise AstriaError(f"Unsupported argument type: {kind}")


def structured_argument(name):
    def parse(value):
        try:
            result = json.loads(value)
        except json.JSONDecodeError as error:
            raise argparse.ArgumentTypeError(str(error)) from error
        if not validate_argument(JSON_ARGUMENT_SCHEMAS[name], result):
            raise argparse.ArgumentTypeError(f"Invalid {name} JSON")
        return result
    return parse


def nullable_id(value):
    if value == "null":
        return None
    if not re.fullmatch(r"[1-9][0-9]*", str(value)):
        raise AstriaError("IDs must be positive integers or 'null' to clear the assignment")
    return int(value)


def operation_path(definition, values):
    path = definition["path"]
    if "path_choice" in definition:
        argument, alternative = definition["path_choice"]
        if values.get(argument):
            path = alternative
    return re.sub(r"\{([^}]+)\}", lambda match: quote(str(values[match[1]]), safe=""), path)


def operation_fields(name, values, resolved_media=None):
    result = []
    resolved_media = resolved_media or {}
    for spec in API_OPERATIONS[name]["fields"]:
        wire, argument, mode = spec[:3]
        value = values.get(argument)
        if value is None or (mode not in ("value", "boolean", "json", "description_object", "nullable_id") and not value):
            continue
        if mode in ("truthy", "value"):
            result.append(field(wire, value))
        elif mode in ("boolean", "flag"):
            result.append(field(wire, "true" if value else "false"))
        elif mode == "array":
            result.extend(field(wire, item) for item in value)
        elif mode == "ids":
            items = value if isinstance(value, list) else [value]
            result.extend(field(wire, item) for raw in items for item in _id_list(raw))
        elif mode == "json":
            result.append((wire, value))
        elif mode == "description_object":
            result.append((wire, {"short_description": value}))
        elif mode == "nullable_id":
            result.append((wire, nullable_id(value)))
        elif mode == "replacements":
            if not validate_argument(JSON_ARGUMENT_SCHEMAS["tune_replacements"], value):
                raise AstriaError("Invalid tune_replacements")
            result.extend(field(f"{wire}[{source}][]", int(target))
                          for source, targets in value.items() for target in targets)
        elif mode == "description":
            result.append(field(wire, json.dumps({"short_description": value}, ensure_ascii=False, separators=(",", ":"))))
        elif mode == "media":
            result.append(media_field(wire, value, resolved_media.get(argument, value)))
        elif mode == "media_array":
            result.extend(field(spec[3] if remote_url(original) else wire, resolved)
                          for original, resolved in zip(value, resolved_media.get(argument, value)))
        else:
            raise AstriaError(f"Unknown operation field mode: {mode}")
    return result


def operation_result(definition, value, values):
    spec = definition["result"]
    if spec.get("first") and isinstance(value, list):
        return value[0]
    if "pick" in spec:
        keys = list(spec["pick"])
        for expanded in values.get("expand") or []:
            keys.extend(spec.get("expand", {}).get(expanded, []))
        return [{key: item.get(key) for key in dict.fromkeys(keys)} for item in value]
    if "object" in spec:
        section = values.get(spec["sections"]["argument"]) if "sections" in spec else None
        keys = spec["sections"]["keys"][section] if section else spec["object"]
        projected = {key: value.get(source, default) for key, (source, default) in spec["object"].items() if key in keys}
        projected.update(spec.get("constants", {}))
        projected.update({key: yes if value.get(condition) else no
                          for key, (condition, yes, no) in spec.get("choices", {}).items()})
        return projected
    return value


def execute_api_operation(name, args, cfg, *, extra_fields=None):
    definition = API_OPERATIONS[name]
    values = vars(args).copy()
    if "model" in definition:
        model = definition["model"]
        values[model["output"]] = (values.get(model["fallback_argument"])
            if "fallback_argument" in model and not values.get(model["argument"])
            else resolve_model(cfg, values.get(model["argument"]), model.get("catalog", MODEL_CATALOG)))
    apply_catalog_defaults(cfg, definition, values)
    if "requires_present" in definition and not any(values.get(key) is not None for key in definition["requires_present"]):
        raise AstriaError("Provide at least one of: " + ", ".join(definition["requires_present"]))
    fields = operation_fields(name, values) + (extra_fields or [])
    options = {definition["target"]: {definition["root"]: dict(fields)} if definition["target"] == "json_body" else fields}
    if definition.get("no_workspace"):
        options["no_workspace"] = True
    else:
        options["workspace"] = values.get("workspace")
    result = request(cfg, definition["method"], operation_path(definition, values), **options)
    return operation_result(definition, result, values)


# --------------------------------------------------------------------------
# errors / output
# --------------------------------------------------------------------------
class AstriaError(Exception):
    pass


_operation_output = contextvars.ContextVar("astria_operation_output", default=None)


def die(msg, code=1):
    if _operation_output.get() is not None:
        raise AstriaError(msg)
    print(f"astria: {msg}", file=sys.stderr)
    sys.exit(code)


def emit(obj):
    """Print a result as JSON on stdout — skills parse this."""
    sink = _operation_output.get()
    if sink is not None:
        sink.append(obj)
        return
    json.dump(obj, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")


# --------------------------------------------------------------------------
# config + credential resolution
# --------------------------------------------------------------------------
def resolve_profile(cli_value):
    """Profile precedence: --profile flag > ASTRIA_PROFILE env > 'default'."""
    profile = cli_value or os.environ.get("ASTRIA_PROFILE") or "default"
    if not profile.replace("-", "").replace("_", "").replace(".", "").isalnum():
        die(f"invalid profile name {profile!r} — use letters, digits, '-', '_', '.'")
    return profile


def argv_profile():
    """Peek at --profile in argv before the parser exists, so build_parser()
    can read the right profile's models cache for the --help enum text."""
    argv = sys.argv[1:]
    for i, token in enumerate(argv):
        if token == "--profile":
            return argv[i + 1] if i + 1 < len(argv) else None
        if token.startswith("--profile="):
            return token.split("=", 1)[1]
    return None


def normalize_meta_argv(argv):
    """Support command-style help/version aliases before argparse requires a verb."""
    command_index = 0
    while command_index < len(argv):
        token = argv[command_index]
        if token == "--profile":
            command_index += 2
            continue
        if token.startswith("--profile="):
            command_index += 1
            continue
        break

    if command_index >= len(argv):
        return argv
    command = argv[command_index]
    if command == "help":
        return argv[:command_index] + argv[command_index + 1:] + ["--help"]
    if command == "version" and command_index == len(argv) - 1:
        return argv[:command_index] + ["--version"]
    return argv


def apply_profile(profile):
    """Point CONFIG_PATH / MODELS_CACHE at this profile's files. The 'default'
    profile keeps the original config.json / models.json names; a named profile
    'X' uses config.X.json / models.X.json — like the AWS CLI's profiles."""
    global ACTIVE_PROFILE, CONFIG_PATH, MODELS_CACHE
    ACTIVE_PROFILE = profile
    suffix = "" if profile == "default" else f".{profile}"
    CONFIG_PATH = CONFIG_DIR / f"config{suffix}.json"
    MODELS_CACHE = CONFIG_DIR / f"models{suffix}.json"


def load_config():
    if CONFIG_PATH.is_file():
        try:
            return json.loads(CONFIG_PATH.read_text())
        except (OSError, ValueError):
            return {}
    return {}


def save_config(cfg):
    CONFIG_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg, indent=2) + "\n")
    CONFIG_PATH.chmod(0o600)


def api_key(cfg):
    key = os.environ.get("ASTRIA_API_KEY") or os.environ.get("ASTRIA_AUTH_TOKEN") or cfg.get("api_key")
    if not key:
        die("not authenticated — run `astria login` (or set ASTRIA_API_KEY)")
    return key


def base_url(cfg):
    return (os.environ.get("ASTRIA_BASE_URL") or cfg.get("base_url") or DEFAULT_BASE_URL).rstrip("/")


def login_hint(cfg, override_base_url=None):
    return f"{(override_base_url or base_url(cfg)).rstrip('/')}/users/edit/api"


def resolve_workspace(cfg, override):
    """Workspace scope: --workspace flag > env > config. `all` and `personal` pass through."""
    ws = override or os.environ.get("ASTRIA_WORKSPACE_ID") or os.environ.get("WORKSPACE_ID") or cfg.get("workspace_id")
    return str(ws) if ws not in (None, "", "personal") else None


def resolve_num_images(cfg, override, fallback):
    value = override or cfg.get("default_num_images") or fallback
    if not str(value).isdigit() or int(value) < 1:
        die("default_num_images / --num-images must be a positive integer")
    return str(value)


# --- model catalog (/cli/models, cached daily) ---
def load_models_cache():
    if MODELS_CACHE.is_file():
        try:
            return json.loads(MODELS_CACHE.read_text())
        except (OSError, ValueError):
            return None
    return None


def models_cache_stale(record, cfg):
    if not record or not record.get("models"):
        return True
    # caches written before music models / the video family default were recorded lack the key entirely
    if "music_models" not in record or "default_video_model_family" not in record:
        return True
    if record.get("base_url") != base_url(cfg):
        return True
    return time.time() - record.get("fetched_at", 0) > record.get("ttl", MODELS_TTL_DEFAULT)


def fetch_models(cfg):
    """Fetch /cli/models and write the cache. Returns the record, or None on failure."""
    try:
        payload = request(cfg, "GET", "/cli/models", auth=False, no_workspace=True)
    except AstriaError:
        return None
    if not isinstance(payload, dict) or not isinstance(payload.get("models"), dict):
        return None
    record = {
        "base_url": base_url(cfg),
        "fetched_at": int(time.time()),
        "ttl": payload.get("cache_ttl") or MODELS_TTL_DEFAULT,
        "default": payload.get("default", "gemini"),
        "model_selection_guidance": payload.get("model_selection_guidance"),
        "default_video_model": payload.get("default_video_model"),
        "default_video_model_family": payload.get("default_video_model_family"),
        "models": payload["models"],
        "video_models": payload.get("video_models") or {},
        "video_model_families": payload.get("video_model_families") or {},
        "default_music_model": payload.get("default_music_model"),
        "music_models": payload.get("music_models") or {},
        "cli": payload.get("cli") or {},
        "skills": payload.get("skills") or {},
    }
    try:
        CONFIG_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        MODELS_CACHE.write_text(json.dumps(record, indent=2) + "\n")
    except OSError:
        pass
    return record


def _version_tuple(v):
    try:
        return tuple(int(x) for x in str(v).split("."))
    except (TypeError, ValueError):
        return None


def install_cli_upgrade(url, target, *, force=False):
    current = _version_tuple(VERSION)

    try:
        proc = subprocess.run(["curl", "-fsSL", "-A", USER_AGENT, url], capture_output=True)
    except FileNotFoundError:
        raise AstriaError("`curl` not found on PATH — install curl")
    if proc.returncode != 0:
        raise AstriaError(f"could not download upgrade from {url}: {proc.stderr.decode('utf-8', 'replace').strip()}")

    try:
        source = proc.stdout.decode("utf-8")
        ast.parse(source)
    except (UnicodeDecodeError, SyntaxError) as exc:
        raise AstriaError(f"downloaded upgrade is not a valid astria CLI script: {exc}")

    new_version = downloaded_cli_version(source)
    downloaded = _version_tuple(new_version)
    if current and downloaded and downloaded < current and not force:
        raise AstriaError(f"refusing to downgrade astria {VERSION} to {new_version}; pass --force to install anyway")
    if current and downloaded and downloaded == current and not force:
        return None
    if not target.is_file():
        raise AstriaError(f"cannot upgrade {target}: executable file not found")
    if not os.access(target, os.W_OK):
        raise AstriaError(f"cannot write {target}; rerun with permissions to update that file")

    tmp = target.with_name(f".{target.name}.upgrade-{os.getpid()}")
    try:
        mode = target.stat().st_mode & 0o777
        tmp.write_bytes(proc.stdout)
        tmp.chmod(mode or 0o755)
        os.replace(tmp, target)
    except OSError as exc:
        raise AstriaError(f"could not install upgrade at {target}: {exc}")
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass

    return new_version


def auto_upgrade_cli(cli):
    if os.environ.get("ASTRIA_NO_AUTO_UPGRADE") or os.environ.get("ASTRIA_UPGRADED"):
        return False

    upgrade = cli.get("upgrade") or "please upgrade the astria CLI"
    target = current_executable_path()
    if not target.is_file() or not os.access(target, os.W_OK):
        print(f"astria: a newer CLI is available ({cli.get('latest_version')}) — {upgrade}", file=sys.stderr)
        return True

    try:
        new_version = install_cli_upgrade(cli.get("download_url") or UPGRADE_URL, target)
    except Exception as exc:
        print(f"astria: auto-upgrade failed: {exc}; {upgrade}", file=sys.stderr)
        return True

    if not new_version:
        return True

    print(f"astria: upgraded {VERSION} -> {new_version}; restarting", file=sys.stderr)
    os.environ["ASTRIA_UPGRADED"] = "1"
    try:
        os.execv(str(target), [str(target)] + sys.argv[1:])
    except OSError as exc:
        print(f"astria: restart after auto-upgrade failed: {exc}", file=sys.stderr)
    return True


def check_cli_version(record, *, auto_upgrade=False):
    """Enforce the min/latest CLI version from the cached /cli/models `cli` block:
    below min_version is a hard stop, below latest_version is an upgrade nudge."""
    cli = (record or {}).get("cli") or {}
    current = _version_tuple(VERSION)
    if not current:
        return
    upgrade = cli.get("upgrade") or "please upgrade the astria CLI"
    minimum = _version_tuple(cli.get("min_version"))
    if minimum and current < minimum:
        die(f"this astria CLI ({VERSION}) is no longer supported — {upgrade}")
    latest = _version_tuple(cli.get("latest_version"))
    if latest and current < latest:
        if auto_upgrade and auto_upgrade_cli(cli):
            return
        print(f"astria: a newer CLI is available ({cli.get('latest_version')}) — {upgrade}",
              file=sys.stderr)


def installed_skills_version():
    root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    if not root:
        return None
    try:
        data = json.loads((Path(root) / ".claude-plugin" / "plugin.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None
    return data.get("version")


def skills_upgrade_context(record):
    current = installed_skills_version()
    if not current:
        return None

    skills = (record or {}).get("skills") or {}
    latest = skills.get("latest_version")
    current_tuple = _version_tuple(current)
    latest_tuple = _version_tuple(latest)
    if not current_tuple or not latest_tuple or current_tuple >= latest_tuple:
        return None

    upgrade = skills.get("upgrade") or "reinstall the Astria skills plugin from astriaai/skills"
    return (
        f"The Astria skills plugin is outdated ({current} < {latest}). "
        f"If the user asks to do anything with Astria, tell them to {upgrade}."
    )


def downloaded_cli_version(source):
    match = re.search(r'^VERSION = "([^"]+)"', source, re.MULTILINE)
    return match.group(1) if match else None


def current_executable_path(override=None):
    if override:
        return Path(override).resolve()
    candidate = Path(sys.argv[0])
    if not candidate.is_absolute() and candidate.parent == Path("."):
        found = shutil.which(sys.argv[0])
        if found:
            candidate = Path(found)
    return candidate.resolve()


def model_catalog(cfg):
    """Model name -> tune id catalog: the cached /cli/models response (refreshed
    daily), falling back to built-in MODEL_TUNES when the endpoint is unreachable."""
    if isinstance(cfg, OperationContext):
        return request(cfg, "GET", "/cli/models", auth=False, no_workspace=True)
    record = load_models_cache()
    if models_cache_stale(record, cfg):
        record = fetch_models(cfg) or record
    if record and record.get("models"):
        return record
    return {
        "default": "gemini",
        "models": {name: {"tune_id": tid} for name, tid in MODEL_TUNES.items()},
        "builtin": True,
    }


# (catalog section, its default key) in /cli/models; songs use ("music_models", "default_music_model")
MODEL_CATALOG = ("models", "default")


def apply_catalog_defaults(cfg, definition, values):
    """Fill omitted arguments from catalog keys, e.g. video_model from default_video_model_family."""
    for argument, key in definition.get("catalog_defaults", {}).items():
        if values.get(argument) is None:
            values[argument] = model_catalog(cfg).get(key)
            if values[argument] is None:
                die(f"the model catalog has no {key} — run `astria models --refresh` or pass --{argument.replace('_', '-')}")


def resolve_model(cfg, name, catalog_keys=MODEL_CATALOG):
    """Map a model name (gemini/seedream/mureka-v9.5/...) or a raw tune id to a tune id."""
    models_key, default_key = catalog_keys
    catalog = None
    if name is None and catalog_keys == MODEL_CATALOG:
        name = cfg.get("default_model")
    if name is None:
        catalog = model_catalog(cfg)
        name = catalog.get(default_key)
        if name is None:
            die(f"the model catalog has no {default_key} — run `astria models --refresh` or pass --model")
    if str(name).isdigit():
        return str(name)
    key = str(name).lower()
    # 1. environment override — the Astria web app injects these
    if not isinstance(cfg, OperationContext) and key in MODEL_ENV and os.environ.get(MODEL_ENV[key]):
        return os.environ[MODEL_ENV[key]]
    # 2. explicit per-model override in the config file
    if cfg.get(f"{key}_tune_id"):
        return str(cfg[f"{key}_tune_id"])
    # 3. the server catalog (cached daily)
    if catalog is None:
        catalog = model_catalog(cfg)
    entry = catalog.get(models_key, {}).get(key)
    if entry and entry.get("tune_id"):
        return str(entry["tune_id"])
    # 4. built-in offline fallback
    if key in MODEL_TUNES:
        return MODEL_TUNES[key]
    die(f"unknown model {name!r} — run `astria models` to list available models, or pass a numeric tune id")


# --------------------------------------------------------------------------
# HTTP — delegated to curl (handles redirects and retries)
# --------------------------------------------------------------------------
def request(cfg, method, path, *, query=None, form=None, json_body=None, workspace=None,
            no_workspace=False, auth=True, timeout=120, idempotency_key=None):
    if isinstance(cfg, OperationContext):
        return cfg.transport(method, path, query=query, form=form, json_body=json_body,
                             workspace=workspace, no_workspace=no_workspace, auth=auth)
    url = base_url(cfg) + path
    if query:
        url += ("&" if "?" in url else "?") + urlencode(query, doseq=True)

    argv = ["curl", "-sS", "--retry", "2", "--max-time", str(timeout), "-A", USER_AGENT, "-X", method,
            "-H", "Accept: application/json"]
    if auth:
        argv += ["-H", f"Authorization: Bearer {api_key(cfg)}"]
    if method != "GET":
        # curl --retry re-sends this exact argv after a timeout or 5xx, so every retry carries the same key and the
        # API returns the request it already accepted instead of creating (and billing) a second one.
        argv += ["-H", f"Idempotency-Key: {idempotency_key or 'astria-cli-' + uuid.uuid4().hex}"]

    if not no_workspace:
        ws = workspace if workspace is not None else resolve_workspace(cfg, None)
        if ws:
            argv += ["-H", f"X-Workspace-Id: {ws}"]

    stdin = None
    if json_body is not None:
        argv += ["-H", "Content-Type: application/json", "--data-binary", "@-"]
        stdin = json.dumps(json_body).encode()
    for key, value in (form or []):
        argv += ["--form-string", f"{key}={value}"]

    argv += ["-w", "\n%{http_code}", url]

    try:
        proc = subprocess.run(argv, input=stdin, capture_output=True)
    except FileNotFoundError:
        die("`curl` not found on PATH — install curl")

    if proc.returncode != 0:
        raise AstriaError(f"network error ({method} {path}): {proc.stderr.decode('utf-8', 'replace').strip()}")

    raw = proc.stdout.decode("utf-8", "replace")
    body, _, status = raw.rpartition("\n")
    try:
        status = int(status)
    except ValueError:
        raise AstriaError(f"unexpected curl output for {method} {path}")

    parsed = None
    if body.strip():
        try:
            parsed = json.loads(body)
        except ValueError:
            parsed = None

    if status == 426:
        hint = (parsed.get("upgrade") or parsed.get("error")) if isinstance(parsed, dict) else None
        die(f"this astria CLI ({VERSION}) is no longer supported — {hint or 'please upgrade to continue'}")
    if status >= 400:
        msg = None
        if isinstance(parsed, dict):
            msg = parsed.get("error") or parsed.get("message")
        raise AstriaError(f"{method} {path} → HTTP {status}: {msg or body.strip()[:400]}")

    return parsed if parsed is not None else body


def field(key, value):
    """A form field. Local attachments are represented by direct-upload signed ids."""
    return (key, value)


def remote_url(value):
    return str(value).startswith(("http://", "https://"))


def media_field(prefix, value, resolved):
    """Resolve an image/video argument to the right form field: URL vs signed id.

    A URL goes in the `_url` variant of the field, with the suffix inserted
    inside the param brackets — `prompt[input_image]` -> `prompt[input_image_url]`."""
    if remote_url(value):
        url_key = f"{prefix[:-1]}_url]" if prefix.endswith("]") else f"{prefix}_url"
        return field(url_key, value)
    return field(prefix, resolved)


DIRECT_UPLOAD_MAX_BYTES = 100 * 1024 * 1024
DIRECT_UPLOAD_WORKERS = 6
CONTENT_TYPE_OVERRIDES = {
    ".avif": "image/avif",
    ".heic": "image/heic",
    ".heif": "image/heif",
    ".mov": "video/quicktime",
    ".webp": "image/webp",
}
DIRECT_UPLOAD_CONTENT_TYPE_PREFIXES = ("image/", "video/", "audio/")


def file_content_type(path):
    return (CONTENT_TYPE_OVERRIDES.get(path.suffix.lower())
            or mimetypes.guess_type(path.name)[0]
            or "application/octet-stream")


def file_md5(path):
    digest = hashlib.md5()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return base64.b64encode(digest.digest()).decode("ascii")


def direct_upload(cfg, value):
    """Upload one local file straight to Active Storage and return its signed id."""
    return direct_uploads(cfg, [value])[0]


def prepare_direct_upload(value):
    path = Path(value)
    if not path.is_file():
        die(f"file not found: {value}")
    size = path.stat().st_size
    if size > DIRECT_UPLOAD_MAX_BYTES:
        die(f"file must be at most 100 MB: {value}")
    content_type = file_content_type(path)
    if content_type != "text/plain" and not content_type.startswith(DIRECT_UPLOAD_CONTENT_TYPE_PREFIXES):
        die(f"unsupported upload content type {content_type}: {value}")
    return path, size, content_type


def perform_direct_upload_record(cfg, prepared):
    path, size, content_type = prepared
    blob = request(cfg, "POST", "/api/direct_uploads", json_body={"blob": {
        "filename": path.name,
        "byte_size": size,
        "checksum": file_md5(path),
        "content_type": content_type,
    }}, no_workspace=True)
    upload = blob["direct_upload"]
    argv = ["curl", "-sS", "--retry", "2", "--max-time", "600", "-X", "PUT"]
    for key, header_value in upload["headers"].items():
        argv += ["-H", f"{key}: {header_value}"]
    argv += ["--data-binary", f"@{path}", "-w", "\n%{http_code}", upload["url"]]
    try:
        proc = subprocess.run(argv, capture_output=True)
    except FileNotFoundError:
        die("`curl` not found on PATH — install curl")
    raw = proc.stdout.decode("utf-8", "replace")
    body, _, status = raw.rpartition("\n")
    if proc.returncode != 0 or not status.isdigit() or int(status) >= 400:
        detail = proc.stderr.decode("utf-8", "replace").strip() or body.strip()[:400]
        raise AstriaError(f"direct upload failed for {path}: {detail or status or 'unexpected response'}")
    return blob


def perform_direct_upload(cfg, prepared):
    return perform_direct_upload_record(cfg, prepared)["signed_id"]


def parallel_direct_upload(cfg, values, upload):
    prepared = [prepare_direct_upload(value) for value in values]
    if not prepared:
        return []
    with concurrent.futures.ThreadPoolExecutor(
            max_workers=min(DIRECT_UPLOAD_WORKERS, len(prepared))) as executor:
        return list(executor.map(lambda item: upload(cfg, item), prepared))


def direct_uploads(cfg, values):
    """Direct-upload local files in parallel and return signed ids in input order."""
    return parallel_direct_upload(cfg, values, perform_direct_upload)


def direct_upload_records(cfg, values):
    """Direct-upload local files in parallel and retain signed ids + public URLs."""
    return parallel_direct_upload(cfg, values, perform_direct_upload_record)


def direct_upload_handoff_records(cfg, paths):
    """Upload bounded handoff files; opaque skill assets travel as text/plain."""
    prepared = []
    for path in paths:
        size = path.stat().st_size
        content_type = file_content_type(path)
        if content_type != "text/plain" and not content_type.startswith(DIRECT_UPLOAD_CONTENT_TYPE_PREFIXES):
            content_type = "text/plain"
        prepared.append((path, size, content_type))
    if not prepared:
        return []
    with concurrent.futures.ThreadPoolExecutor(
            max_workers=min(DIRECT_UPLOAD_WORKERS, len(prepared))) as executor:
        return list(executor.map(lambda item: perform_direct_upload_record(cfg, item), prepared))


def resolve_media_values(cfg, values):
    """Replace local paths with signed ids while leaving remote URLs untouched."""
    uploads = iter(direct_uploads(cfg, [value for value in values if not remote_url(value)]))
    return [value if remote_url(value) else next(uploads) for value in values]


def image_reference_fields(values, resolved_values):
    values = values or []
    source_kinds = {
        "url" if remote_url(value) else "file"
        for value in values
    }
    if len(source_kinds) > 1:
        die("--image-reference cannot mix URLs and local files in one request")

    fields = []
    for value, resolved in zip(values, resolved_values):
        if source_kinds == {"url"}:
            fields.append(field("prompt[image_reference_urls][]", value))
            continue
        fields.append(field("prompt[image_references][]", resolved))
    return fields


# --------------------------------------------------------------------------
# polling
# --------------------------------------------------------------------------
WAIT_TIMEOUT_SEC = 600
WAIT_INTERVAL_SEC = 5
WAIT_INTERVAL_MIN = 2
WAIT_WORKERS = 6


def prompt_settled(prompt):
    """A prompt is settled once it has images OR a user_error — both are terminal."""
    return bool(prompt.get("images")) or bool(prompt.get("user_error"))


def wait_prompts(cfg, ids, *, workspace=None, timeout=WAIT_TIMEOUT_SEC,
                 interval=WAIT_INTERVAL_SEC, on_settled=None):
    """Poll many prompt ids in parallel until each settles or the wall-clock
    timeout fires. Returns {id: prompt_record_or_None}. on_settled(id, record)
    fires once per id as soon as it settles, so callers can stream output."""
    interval = max(WAIT_INTERVAL_MIN, interval)
    deadline = time.monotonic() + timeout
    settled = {}
    pending = list(ids)

    while pending and time.monotonic() < deadline:
        round_start = time.monotonic()
        queue = list(pending)
        lock = threading.Lock()
        results = {}
        errors = {}

        def pump():
            while True:
                with lock:
                    if not queue:
                        return
                    pid = queue.pop(0)
                try:
                    results[pid] = request(cfg, "GET", f"/prompts/{pid}.json", workspace=workspace)
                except AstriaError as exc:
                    # Transient — retry this id next round, don't mark settled.
                    errors[pid] = str(exc)

        threads = [threading.Thread(target=pump) for _ in range(min(WAIT_WORKERS, len(queue)))]
        for t in threads:
            t.start()
        for t in threads:
            t.join()

        still_pending = []
        for pid in pending:
            record = results.get(pid)
            if record is not None and prompt_settled(record):
                settled[pid] = record
                if on_settled:
                    on_settled(pid, record)
            else:
                still_pending.append(pid)
        pending = still_pending

        if not pending:
            break
        # Sleep the remainder of the interval — but not past the deadline.
        elapsed = time.monotonic() - round_start
        nap = min(max(0.0, interval - elapsed), max(0.0, deadline - time.monotonic()))
        if nap > 0:
            time.sleep(nap)

    for pid in pending:
        settled.setdefault(pid, None)
    return settled


def poll_prompt(cfg, tune_id, prompt_id, workspace=None):
    """Single-prompt wait used by `generate --wait` / `video --wait`. Delegates
    to wait_prompts so both code paths share the same settle rules."""
    results = wait_prompts(cfg, [str(prompt_id)], workspace=workspace,
                           timeout=WAIT_TIMEOUT_SEC, interval=WAIT_INTERVAL_SEC)
    record = results.get(str(prompt_id))
    if record is None:
        raise AstriaError(f"prompt {prompt_id} did not finish within {WAIT_TIMEOUT_SEC}s")
    return record


# --------------------------------------------------------------------------
# commands — auth
# --------------------------------------------------------------------------
def cmd_login(args, cfg):
    key = args.api_key
    if not key:
        if sys.stdin.isatty():
            try:
                import getpass
                key = getpass.getpass(f"Astria API key ({login_hint(cfg, args.base_url)}): ").strip()
            except (EOFError, KeyboardInterrupt):
                die("aborted")
        else:
            key = sys.stdin.readline().strip()
    if not key:
        die("no API key provided")

    cfg["api_key"] = key
    if args.base_url:
        cfg["base_url"] = args.base_url.rstrip("/")
    if args.workspace:
        cfg["workspace_id"] = args.workspace
    save_config(cfg)

    try:
        user = request(cfg, "GET", "/users", no_workspace=True)
        who = user.get("name") or user.get("email") or "your account"
        print(f"Logged in as {who} (profile '{ACTIVE_PROFILE}'). Config saved to {CONFIG_PATH}")
    except AstriaError as exc:
        die(f"saved key but verification failed: {exc}")


def cmd_logout(args, cfg):
    if CONFIG_PATH.is_file():
        CONFIG_PATH.unlink()
        print(f"Removed {CONFIG_PATH}")
    else:
        print("Not logged in.")


def cmd_whoami(args, cfg):
    user = request(cfg, "GET", "/users", no_workspace=True)
    emit({k: user.get(k) for k in ("id", "name", "email", "usd_balance_mc", "purchased_plugin_at")})


def cmd_config(args, cfg):
    if args.action == "get" or args.action is None:
        emit({
            "profile": ACTIVE_PROFILE,
            "base_url": base_url(cfg),
            "workspace_id": resolve_workspace(cfg, None),
            "default_model": cfg.get("default_model", "gemini"),
            "default_num_images": cfg.get("default_num_images"),
            "config_path": str(CONFIG_PATH),
            "authenticated": bool(os.environ.get("ASTRIA_API_KEY") or os.environ.get("ASTRIA_AUTH_TOKEN") or cfg.get("api_key")),
        })
    elif args.action == "set":
        if not args.key or args.value is None:
            die("usage: astria config set <key> <value>")
        aliases = {"workspace": "workspace_id"}
        allowed = {"base_url", "workspace_id", "workspace", "default_model", "default_num_images",
                   "gemini_tune_id", "seedream_tune_id", "gpt-image-2_tune_id"}
        if args.key not in allowed:
            die(f"unknown config key {args.key!r} — one of: {', '.join(sorted(allowed))}")
        key = aliases.get(args.key, args.key)
        if key == "default_num_images":
            if not str(args.value).isdigit() or int(args.value) < 1:
                die("default_num_images must be a positive integer")
            cfg[key] = str(int(args.value))
        else:
            cfg[key] = args.value
        save_config(cfg)
        print(f"Set {key} = {cfg[key]}")


def cmd_models(args, cfg):
    record = fetch_models(cfg) if args.refresh else model_catalog(cfg)
    if record is None:
        die("could not refresh models from the server")
    emit(operation_result(API_OPERATIONS["list_models"], record, vars(args)))

def cmd_upgrade(args, cfg):
    record = None if args.url else fetch_models(cfg)
    record = record or load_models_cache() or {}
    cli = record.get("cli") or {}
    url = args.url or cli.get("download_url") or UPGRADE_URL
    target = current_executable_path(args.path)
    new_version = install_cli_upgrade(url, target, force=args.force)
    if not new_version:
        print(f"astria {VERSION} is already current at {target}")
        return
    print(f"Upgraded astria {VERSION} -> {new_version or 'unknown'} at {target}")


