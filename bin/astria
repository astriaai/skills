REMOTE_MEDIA_ARGUMENTS = {
    "image_url", "input_image", "mask_image", "references", "image_references",
    "first_frame", "last_frame", "input_video", "audio_reference",
}


class OperationContext(dict):
    """Request-scoped API transport. Never resolves CLI files or credentials."""
    def __init__(self, transport):
        super().__init__()
        self.transport = transport


def operation_parser(path):
    parser = build_parser(models_record={})
    for command in path:
        subcommands = next(action for action in parser._actions
                           if isinstance(action, argparse._SubParsersAction))
        help_text = next((choice.help for choice in subcommands._choices_actions
                          if choice.dest == command), "")
        parser = subcommands.choices[command]
        if not parser.description:
            parser.description = help_text
    return parser


# Updates replace saved metadata or assignments rather than only adding content.
DESTRUCTIVE_OPERATIONS = {
    "update_reference", "update_prompt", "update_template", "update_workspace",
}


def mcp_help(parser, text):
    """CLI help in MCP terms: 'astria models --type X' is list_models type=X, --flag-name its argument."""
    text = re.sub(r"'astria models(?: --type (\w+))?'", lambda m: "list_models" + (f" type={m[1]}" if m[1] else ""), text)
    flags = {option: action.dest for action in parser._actions for option in action.option_strings}
    return re.sub(r"--[a-z][a-z-]*", lambda m: flags.get(m[0], m[0]), text)


def operation_catalog():
    validate_operation_coverage()
    tools = []
    for name, (path, readonly, excluded) in OPERATION_POLICIES.items():
        parser = operation_parser(path)
        properties = {}
        required = []
        for action in parser._actions:
            if action.dest in excluded or action.dest == "help":
                continue
            boolean = isinstance(action, (argparse._StoreTrueAction, argparse.BooleanOptionalAction))
            spec = {"type": "boolean" if boolean else "string"}
            if action.choices is not None:
                spec["enum"] = list(action.choices)
            if isinstance(action, argparse._AppendAction):
                spec = {"type": "array", "items": spec}
            if action.help and action.help != argparse.SUPPRESS:
                spec["description"] = mcp_help(parser, action.help.replace("%(default)s", str(action.default)))
            if action.dest in JSON_ARGUMENT_SCHEMAS:
                spec = JSON_ARGUMENT_SCHEMAS[action.dest].copy() | {"description": mcp_help(parser, action.help)}
            properties[action.dest] = spec
            if action.required or not action.option_strings:
                required.append(action.dest)
        # These flags are validated by their handlers in terminal use.
        if name == "generate_images":
            required.append("text")
        if name == "get_prompt":
            required.append("tune")
        if name == "create_reference":
            required.append("image_url")
        if not readonly:
            properties["idempotency_key"] = {"type": "string", "minLength": 1,
                "description": "Unique submission key. Reuse it only when retrying the same operation."}
            required.append("idempotency_key")
        tools.append({
            "name": name,
            "title": name.replace("_", " ").title(),
            "description": OPERATION_DESCRIPTIONS[name],
            "inputSchema": {"type": "object", "properties": properties,
                            "required": list(dict.fromkeys(required)), "additionalProperties": False},
            "outputSchema": {"type": "object", "properties": {"result": {}},
                             "required": ["result"], "additionalProperties": False},
            "annotations": {"readOnlyHint": readonly, "destructiveHint": name in DESTRUCTIVE_OPERATIONS,
                            "openWorldHint": not readonly},
            "securitySchemes": [{"type": "oauth2", "scopes": []}],
        })
    return tools


def operation_contract():
    operations = {}
    for tool in operation_catalog():
        name = tool["name"]
        definition = API_OPERATIONS[name]
        path, _readonly, _excluded = OPERATION_POLICIES[name]
        parser = operation_parser(path)
        actions = [action for action in parser._actions if action.dest != "help"]
        covered = {spec[1] for spec in definition["fields"]} | {"workspace", "idempotency_key"}
        covered.update(re.findall(r"\{([^}]+)\}", definition["path"]))
        if "path_choice" in definition:
            covered.add(definition["path_choice"][0])
            covered.update(re.findall(r"\{([^}]+)\}", definition["path_choice"][1]))
        if "model" in definition:
            covered.add(definition["model"]["argument"])
            if "fallback_argument" in definition["model"]:
                covered.add(definition["model"]["fallback_argument"])
        if "references" in definition:
            covered.add(definition["references"]["argument"])
        if "sections" in definition["result"]:
            covered.add(definition["result"]["sections"]["argument"])
        unmapped = set(tool["inputSchema"]["properties"]) - covered
        if unmapped:
            raise AstriaError(f"{name} has unmapped parameters: {sorted(unmapped)}")
        operations[name] = {**definition,
            "defaults": {**{spec[1]: None for spec in definition["fields"]},
                         **{action.dest: action.default for action in actions}},
            "integer_arguments": [action.dest for action in actions if action.type is int]}
    return {"version": 1, "operations": operations, "cli_only_commands": {" ".join(path): reason for path, reason in CLI_ONLY_COMMANDS.items()}, "prompt_filters": PROMPT_FILTERS,
            "remote_media_arguments": sorted(REMOTE_MEDIA_ARGUMENTS),
            "fallback_models": MODEL_TUNES, "fallback_default": "gemini"}


def run_operation(name, arguments, transport):
    """Execute a shared handler without terminal output, local state or tokens."""
    path, _readonly, excluded = OPERATION_POLICIES[name]
    tool = next(tool for tool in operation_catalog() if tool["name"] == name)
    schema = tool["inputSchema"]
    unknown = set(arguments) - set(schema["properties"])
    missing = set(schema["required"]) - set(arguments)
    if unknown or missing:
        raise AstriaError(f"Invalid arguments: unknown={sorted(unknown)}, missing={sorted(missing)}")
    parser = operation_parser(path)
    values = {action.dest: action.default for action in parser._actions if action.dest != "help"}
    for key, value in arguments.items():
        spec = schema["properties"][key]
        if not validate_argument(spec, value):
            raise AstriaError(f"Invalid value for {key}")
        if key in REMOTE_MEDIA_ARGUMENTS:
            media = value if isinstance(value, list) else [value]
            for item in media:
                url = item.split("=", 1)[1] if key == "references" and "=" in item else item
                parsed = urlparse(url)
                if parsed.scheme != "https" or not parsed.hostname or parsed.username:
                    raise AstriaError(f"{key} requires HTTPS URLs; local files belong to the CLI")
        if key != "idempotency_key":
            values[key] = value
    for action in parser._actions:
        if action.dest in values and action.type is not None and values[action.dest] is not None and action.dest not in JSON_ARGUMENT_SCHEMAS:
            values[action.dest] = action.type(values[action.dest])
    output = []
    marker = _operation_output.set(output)
    try:
        parser.get_default("func")(argparse.Namespace(**values), OperationContext(transport))
    finally:
        _operation_output.reset(marker)
    if len(output) != 1:
        raise AstriaError("Operation must return exactly one structured result")
    return output[0]


def main():
    # Resolve the profile up front so build_parser() reads that profile's
    # cached model catalog for the --help enum text; re-resolve from the
    # parsed args afterwards so the flag stays authoritative.
    sys.argv[1:] = normalize_meta_argv(sys.argv[1:])
    apply_profile(resolve_profile(argv_profile()))
    args = build_parser().parse_args()
    apply_profile(resolve_profile(args.profile))
    cfg = load_config()
    if args.command != "upgrade":
        check_cli_version(load_models_cache(), auto_upgrade=True)
    try:
        args.func(args, cfg)
    except AstriaError as exc:
        die(str(exc))
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        die("interrupted", code=130)


if __name__ == "__main__":
    main()
