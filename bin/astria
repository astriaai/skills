def prompt_attribute_overrides(args):
    """Collect the per-prompt override flags into a prompt_attributes dict, sent
    under tune[prompt_attributes][...]. Named flags cover the common knobs;
    --attr KEY=VALUE is the escape hatch for any other prompt attribute."""
    attrs = {}
    if args.num_images:
        attrs["num_images"] = args.num_images
    if args.aspect_ratio:
        attrs["aspect_ratio"] = args.aspect_ratio
    if args.resolution:
        attrs["resolution"] = args.resolution
    if args.inpaint_faces is not None:
        attrs["inpaint_faces"] = "true" if args.inpaint_faces else "false"
    for raw in (args.attr or []):
        if "=" not in raw:
            die(f"--attr must be KEY=VALUE (got {raw!r})")
        key, value = raw.split("=", 1)
        attrs[key.strip()] = value.strip()
    return attrs


def _id_list(value):
    return [int(v) for v in str(value).split(",") if v.strip()] if value else []


def cmd_packs_run(args, cfg):
    if not any((args.tune_id, args.title, args.name, args.image, args.image_url, args.tune_replacements)):
        die("nothing to run — pass --tune-id (existing tunes) or a training set (--title/--name/--image)")
    values = vars(args).copy()
    values["image"] = direct_uploads(cfg, args.image or [])
    # Named overrides are defined once in the shared contract; --attr is the
    # CLI-only escape hatch for additional prompt attributes.
    extras = []
    for raw in args.attr or []:
        if "=" not in raw:
            die(f"--attr must be KEY=VALUE (got {raw!r})")
        key, value = raw.split("=", 1)
        extras.append(field(f"tune[prompt_attributes][{key.strip()}]", value.strip()))
    emit(execute_api_operation("run_template", argparse.Namespace(**values), cfg, extra_fields=extras))

