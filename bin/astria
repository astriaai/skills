    emit(execute_api_operation("update_prompt", args, cfg))

def cmd_prompts_wait(args, cfg):
    ids = collect_prompt_ids(args)
    if not ids:
        die("no prompt ids — pass them as arguments, via --prompts-file, or on stdin")

    out_lock = threading.Lock()
    counts = {"done": 0, "failed": 0}

    def on_settled(pid, record):
        status = "done" if record.get("images") else "failed"
        counts[status] += 1
        line = {
            "id": pid,
            "images": record.get("images") or [],
            "user_error": record.get("user_error"),
            "status": status,
            "settled_at": int(time.time()),
        }
        with out_lock:
            json.dump(line, sys.stdout, ensure_ascii=False)
            sys.stdout.write("\n")
            sys.stdout.flush()

    results = wait_prompts(cfg, ids, workspace=args.workspace,
                           timeout=args.timeout, interval=args.interval,
                           on_settled=on_settled)
    timed_out = [pid for pid in ids if results.get(pid) is None]
    summary = {
        "total": len(ids),
        "succeeded": counts["done"],
        "failed": counts["failed"],
        "timed_out": timed_out,
    }
    with out_lock:
        json.dump(summary, sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        sys.stdout.flush()
    if timed_out:
        sys.exit(1)


# --------------------------------------------------------------------------
# commands — generate (image) / video
# --------------------------------------------------------------------------
def parse_reference_specs(values):
    specs = []
    for raw in values or []:
        if "=" not in raw:
            die("invalid --reference value: use NAME=PATH_OR_URL, e.g. --reference woman=./model.jpg")
        name, image = raw.split("=", 1)
        name = name.strip()
        image = image.strip()
        if not name or not image:
            die("invalid --reference value: both NAME and PATH_OR_URL are required")
        specs.append((name, image))
    return specs


def reference_image_field(value, resolved):
    if remote_url(value):
        return field("tune[image_urls][]", value)
    return field("tune[images][]", resolved)


def reference_title(name, image):
    parsed = urlparse(str(image))
    label = Path(parsed.path).stem if parsed.scheme else Path(image).stem
    return label or name


def create_reference_mentions(args, cfg, tune_id, reference_specs, resolved_images):
    mentions = []
    for (name, image), resolved in zip(reference_specs, resolved_images):
        values = {"title": reference_title(name, image), "name": name, "model_type": "faceid",
                  "model_id": tune_id, "image_url": [image] if remote_url(image) else [],
                  "image": [] if remote_url(image) else [resolved]}
        definition = API_OPERATIONS["create_reference"]
        tune = request(cfg, definition["method"], definition["path"],
                       form=operation_fields("create_reference", values), workspace=args.workspace)
        mentions.append(f"<faceid:{tune['id']}:1> {tune['name']}")
    return mentions

def prepend_reference_mentions(text, mentions):
    if text is None:
        return text
    missing = [mention for mention in mentions if mention.split(" ", 1)[0] not in text]
    return f"{' '.join(missing)} {text}".strip() if missing else text


def _generate(args, cfg, video):
    name = "generate_video" if video else "generate_images"
    definition = API_OPERATIONS[name]
    reference_specs = parse_reference_specs(getattr(args, "references", None))
    tune_id = resolve_model(cfg, args.model)
    image_references = args.image_references or [] if video else []
    if len({"url" if remote_url(value) else "file" for value in image_references}) > 1:
        die("--image-reference cannot mix URLs and local files in one request")
    reference_images = [image for _, image in reference_specs]
    # Contract field order preserves the existing single-batch upload order.
    media_inputs = []
    resolved = {spec[1]: [] for spec in definition["fields"] if spec[2] == "media_array"}
    for spec in definition["fields"]:
        if spec[2] not in ("media", "media_array"):
            continue
        value = getattr(args, spec[1], None)
        values = [value] if spec[2] == "media" else value or []
        media_inputs.extend((spec[1], item) for item in values if item)
    resolved_media = resolve_media_values(cfg, reference_images + [value for _, value in media_inputs])
    for (argument, _value), uploaded in zip(media_inputs, resolved_media[len(reference_images):]):
        if argument in resolved and isinstance(resolved[argument], list):
            resolved[argument].append(uploaded)
        else:
            resolved[argument] = uploaded
    reference_mentions = create_reference_mentions(args, cfg, tune_id, reference_specs, resolved_media[:len(reference_images)])
    values = vars(args).copy()
    apply_catalog_defaults(cfg, definition, values)
    values["model_id"] = tune_id
    for text_argument in definition["references"]["texts"]:
        values[text_argument] = prepend_reference_mentions(getattr(args, text_argument), reference_mentions)
    counts = definition["image_count"]
    values["num_images"] = resolve_num_images(cfg, args.num_images,
        counts["edit"] if values.get(counts["input"]) else counts["generate"])
    # Both generate_audio and video_audio remain in the shared definition,
    # preserving the existing audio compatibility patch.
    prompt = request(cfg, definition["method"], operation_path(definition, values),
                     form=operation_fields(name, values, resolved), workspace=args.workspace)
    prompt = operation_result(definition, prompt, values)
    if args.wait:
        prompt = poll_prompt(cfg, tune_id, prompt["id"], workspace=args.workspace)
    emit(prompt)

def cmd_generate(args, cfg):
    if getattr(args, "video_prompt", None):
        die("--video-prompt belongs to `astria video`, not `astria generate`. Use `astria video --video-prompt ...` for video generation.")
    if not args.text:
        die("--text is required for `astria generate`. For video generation without a first-frame prompt, use `astria video --video-prompt ...`.")
    _generate(args, cfg, video=False)


def cmd_video(args, cfg):
    if getattr(args, "input_image", None):
        die("--input-image is for image generation/editing. For video, use --first-frame, --last-frame, --input-video, --image-reference, or --reference NAME=PATH_OR_URL.")
    _generate(args, cfg, video=True)


def cmd_music(args, cfg):
    prompt = execute_api_operation("generate_music", args, cfg)
    if args.wait:
        prompt = poll_prompt(cfg, prompt["tune_id"], prompt["id"], workspace=args.workspace)
    emit(prompt)


VARIATE_VIDEO_MODEL = "seedance25_720p"
VARIATE_PROMPT_SCHEMA = {
    "type": "object",
    "properties": {
        "video_prompt": {"type": "string"},
    },
    "required": ["video_prompt"],
    "additionalProperties": False,
}
VARIATE_SYSTEM_MESSAGE = (
    "Write one production-ready Seedance 2.5 video-to-video edit prompt. "
    "Use the source video description as factual timing, action, staging, camera, lighting, "
    "transitions, and audio context. Apply the edit brief without inventing changes it does not request. "
    "When replacement reference tokens are supplied, include every token exactly once and state clearly "
    "what each replaces. Do not mention the source description, brief, these instructions, or analysis. "
    "Return only the requested JSON."
)


def parse_variate_reference_specs(values):
    specs = []
    for raw in values or []:
        name = None
        source = raw.strip()
        if "=" in source:
            candidate, separator, remainder = source.partition("=")
            if (separator and candidate.strip() and remainder.strip()
                    and not remote_url(candidate.strip())
                    and "/" not in candidate and "\\" not in candidate):
                name = candidate.strip()
                source = remainder.strip()
        if not source:
            die("invalid --reference value: PATH_OR_URL cannot be empty")
        specs.append({"name": name, "source": source})
    return specs


def variate_reference_title(name, source, class_info):
    parsed = urlparse(str(source))
    filename = Path(parsed.path).name if parsed.scheme else Path(source).name
    stem = Path(filename).stem
    return (class_info.get("first_name") or class_info.get("short_description")
            or stem or name or class_info.get("class_name") or "image")


def create_variate_reference(args, cfg, default_tune_id, spec, upload_record):
    source = spec["source"]
    class_info = {}
    if not spec["name"]:
        class_info = request(
            cfg,
            "POST",
            "/images/class_name",
            form=[field("file_url", source if remote_url(source) else upload_record["public_url"])],
            workspace=args.workspace,
        )
    name = spec["name"] or class_info.get("class_name") or "image"
    characteristics = {
        key: value
        for key, value in class_info.items()
        if key not in ("class_name", "captions")
    }
    form = [
        field("tune[title]", variate_reference_title(name, source, class_info)),
        field("tune[name]", name),
    ]
    if characteristics.get("short_description"):
        form.append(field("tune[characteristics]", json.dumps(characteristics)))
    form += [
        field("tune[model_type]", "faceid"),
        field("tune[base_tune_id]", default_tune_id),
        reference_image_field(source, source if remote_url(source) else upload_record["signed_id"]),
        field("tune[image_captions][]", class_info.get("caption", "")),
    ]
    tune = request(cfg, "POST", "/tunes", form=form, workspace=args.workspace)
    return {
        "id": tune["id"],
        "name": tune["name"],
        "title": tune.get("title") or variate_reference_title(name, source, class_info),
        "source": source,
        "created": True,
    }


def variate_prompt_messages(description, brief, references):
    tokens = [f"<faceid:{reference['id']}:1>" for reference in references]
    reference_tokens = "\n".join(tokens) or "(none)"
    return [
        {"role": "system", "content": VARIATE_SYSTEM_MESSAGE},
        {
            "role": "user",
            "content": "\n\n".join([
                f"Source video description:\n{description.strip()}",
                f"Edit brief:\n{brief.strip() or '(none)'}",
                f"Replacement reference tokens:\n{reference_tokens}",
            ]),
        },
    ]


def compose_variate_video_prompt(args, cfg, description, references):
    response = request(
        cfg,
        "POST",
        "/assist/complete",
        json_body={
            "messages": variate_prompt_messages(description, args.brief, references),
            "response_schema": VARIATE_PROMPT_SCHEMA,
        },
        workspace=args.workspace,
        timeout=30,
    )
    try:
        video_prompt = json.loads(response["text"])["video_prompt"].strip()
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise AstriaError("the Variate prompt writer returned invalid JSON") from exc
    if not video_prompt:
        raise AstriaError("the Variate prompt writer returned an empty video prompt")
    missing_tokens = [
        f"<faceid:{reference['id']}:1>"
        for reference in references
        if f"<faceid:{reference['id']}:1>" not in video_prompt
    ]
    return (f"Replace objects in the scene with {' '.join(missing_tokens)}. {video_prompt}"
            if missing_tokens else video_prompt)


INSPECT_TIMEOUT_SEC = 240
INSPECT_INTERVAL_SEC = 2


def inspect_video(cfg, payload, workspace=None):
    """POST /videos/inspect only enqueues the inspection (download, ffmpeg and
    Gemini run on Astria's worker); poll GET /videos/inspect/<id> until it
    settles. Servers that still answer synchronously return `description`
    straight away and skip the loop."""
    record = request(cfg, "POST", "/videos/inspect", json_body=payload,
                     workspace=workspace, timeout=125)
    if not isinstance(record, dict):
        raise AstriaError("unexpected response from POST /videos/inspect")
    deadline = time.monotonic() + INSPECT_TIMEOUT_SEC
    while record.get("status") in ("pending", "processing"):
        if time.monotonic() > deadline:
            raise AstriaError(f"video inspection {record.get('id')} did not finish within {INSPECT_TIMEOUT_SEC}s")
        time.sleep(INSPECT_INTERVAL_SEC)
        record = request(cfg, "GET", f"/videos/inspect/{record['id']}",
                         workspace=workspace, timeout=30)
        if not isinstance(record, dict):
            raise AstriaError("unexpected response from GET /videos/inspect")
    if record.get("status") == "failed":
        raise AstriaError(f"video inspection failed: {record.get('error') or 'unknown error'}")
    if not str(record.get("description") or "").strip():
        raise AstriaError("video inspection returned no description")
    return record


def variate_description(args, cfg, source_payload):
    if args.description is not None:
        description = args.description.strip()
    elif args.description_file:
        path = Path(args.description_file)
        if not path.is_file():
            die(f"file not found: {args.description_file}")
        description = path.read_text(encoding="utf-8").strip()
    else:
        inspected = inspect_video(cfg, source_payload, workspace=args.workspace)
        description = inspected["description"].strip()
    if not description:
        die("video description cannot be empty")
    return description


def cmd_variate(args, cfg):
    if remote_url(args.source) and not args.source.startswith("https://"):
        die("video URL must use HTTPS")

    reference_specs = parse_variate_reference_specs(args.references)
    existing_ids = []
    for value in args.tune_ids or []:
        if not str(value).isdigit():
            die(f"invalid tune id: {value}")
        tune_id = int(value)
        if tune_id not in existing_ids:
            existing_ids.append(tune_id)
    if not args.brief.strip() and not reference_specs and not existing_ids:
        die("provide --brief, --reference, or --tune-id")

    catalog = model_catalog(cfg)
    video_models = catalog.get("video_models")
    if video_models is not None and VARIATE_VIDEO_MODEL not in video_models:
        die(f"{VARIATE_VIDEO_MODEL} is not available for this account")
    default_tune_id = resolve_model(cfg, None)

    local_values = ([] if remote_url(args.source) else [args.source]) + [
        spec["source"] for spec in reference_specs if not remote_url(spec["source"])
    ]
    upload_records = iter(direct_upload_records(cfg, local_values))
    source_record = None if remote_url(args.source) else next(upload_records)
    reference_uploads = [
        None if remote_url(spec["source"]) else next(upload_records)
        for spec in reference_specs
    ]
    source_payload = (
        {"file_url": args.source}
        if remote_url(args.source)
        else {"blob_signed_id": source_record["signed_id"]}
    )
    description = variate_description(args, cfg, source_payload)

    references = [
        {"id": tune_id, "created": False}
        for tune_id in existing_ids
    ]
    references += [
        create_variate_reference(args, cfg, default_tune_id, spec, upload_record)
        for spec, upload_record in zip(reference_specs, reference_uploads)
    ]
    video_prompt = compose_variate_video_prompt(args, cfg, description, references)

    prompt_payload = {
        "text": "",
        "tune_id": int(default_tune_id),
        "video_model": VARIATE_VIDEO_MODEL,
        "video_prompt": video_prompt,
        "video_audio": True,
        "input_video_url" if remote_url(args.source) else "input_video": (
            args.source if remote_url(args.source) else source_record["signed_id"]
        ),
    }
    if args.base_pack_id:
        prompt_payload["base_pack_id"] = args.base_pack_id
    if args.order_id:
        prompt_payload["order_id"] = args.order_id
    response = request(
        cfg,
        "POST",
        "/prompts",
        query=[("view", "board")],
        json_body={"prompt": prompt_payload},
        workspace=args.workspace,
    )
    prompt = response["prompt"]
    if args.wait:
        prompt = poll_prompt(cfg, default_tune_id, prompt["id"], workspace=args.workspace)
    emit({
        "description": description,
        "references": references,
        "video_prompt": video_prompt,
        "prompt": prompt,
    })


def cmd_inspect_video(args, cfg):
    if str(args.source).startswith(("http://", "https://")):
        if not str(args.source).startswith("https://"):
            die("video URL must use HTTPS")
        payload = {"file_url": args.source}
    else:
        payload = {"blob_signed_id": direct_upload(cfg, args.source)}
    if args.tune_id:
        payload["tune_ids"] = [int(tune_id) for tune_id in args.tune_id]
    emit(inspect_video(cfg, payload, workspace=args.workspace))


def cmd_inspect(args, cfg):
    if remote_url(args.source):
        if not args.source.startswith("https://"):
            die("image URL must use HTTPS")
        image_url = args.source
    else:
        image_url = direct_upload_records(cfg, [args.source])[0]["public_url"]

    form = [field("file_url", image_url)]
    form.extend(field("names[]", name) for name in args.name or [])
    result = request(
        cfg,
        "POST",
        "/images/describe",
        form=form,
        workspace=args.workspace,
        timeout=125,
    )
    if not isinstance(result, dict) or not str(result.get("description") or "").strip():
        raise AstriaError("image inspection returned no description")
    emit(result)


