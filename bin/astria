# --------------------------------------------------------------------------
# commands — external agent handoff
# --------------------------------------------------------------------------
HANDOFF_MAX_MARKDOWN_BYTES = 256 * 1024
HANDOFF_MAX_FILE_BYTES = 10 * 1024 * 1024
HANDOFF_MAX_TOTAL_BYTES = 25 * 1024 * 1024
HANDOFF_MAX_FILES = 50
HANDOFF_SECRET_NAMES = {
    ".env", ".git", ".ssh", ".aws", "credentials.json", "id_rsa", "id_ed25519",
}


def handoff_source():
    client = (_client_token() or "").lower()
    if "claude" in client:
        return "claude-code"
    if "chatgpt" in client or "codex" in client:
        return "chatgpt"
    if os.environ.get("CODEX_HOME"):
        return "chatgpt"
    if "cursor" in client:
        return "cursor"
    return "other"


def handoff_sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def safe_bundle_segment(value):
    cleaned = re.sub(r"[^A-Za-z0-9._ -]", "_", value).strip(" .")
    return cleaned or "file"


def validate_handoff_source(path):
    if path.is_symlink():
        die(f"handoff paths may not be symlinks: {path}")
    lowered = {part.lower() for part in path.parts}
    if lowered & HANDOFF_SECRET_NAMES or any(part.startswith(".env.") for part in lowered):
        die(f"refusing to upload likely credential material: {path}")


def collect_handoff_path(value, bundle_root, kind, require_skill=False):
    root = Path(value).expanduser()
    if not root.exists():
        die(f"handoff path not found: {value}")
    validate_handoff_source(root)
    if require_skill and (not root.is_dir() or not (root / "SKILL.md").is_file()):
        die(f"skill directory must contain SKILL.md: {value}")

    paths = [root] if root.is_file() else sorted(path for path in root.rglob("*") if path.is_file())
    records = []
    for path in paths:
        validate_handoff_source(path)
        relative = Path(path.name) if root.is_file() else path.relative_to(root)
        destination = Path(bundle_root)
        if root.is_dir():
            destination /= safe_bundle_segment(root.name)
        destination /= Path(*(safe_bundle_segment(part) for part in relative.parts))
        records.append({
            "local_path": path,
            "path": destination.as_posix(),
            "kind": kind,
        })
    return records


def cmd_agent_handoff(args, cfg):
    workspace = resolve_workspace(cfg, args.workspace)
    if not workspace or workspace == "all":
        die("a workspace is required — pass --workspace or set WORKSPACE_ID")

    handoff_path = Path(args.handoff).expanduser()
    if not handoff_path.is_file():
        die(f"handoff file not found: {args.handoff}")
    validate_handoff_source(handoff_path)
    handoff_bytes = handoff_path.read_bytes()
    if len(handoff_bytes) > HANDOFF_MAX_MARKDOWN_BYTES:
        die("handoff markdown must be at most 256 KB")
    try:
        handoff_markdown = handoff_bytes.decode("utf-8")
    except UnicodeDecodeError:
        die("handoff markdown must be UTF-8 text")

    records = [
        record
        for value in (args.attach or [])
        for record in collect_handoff_path(value, "files", "attachment")
    ] + [
        record
        for value in (args.skill or [])
        for record in collect_handoff_path(value, "skills", "skill", require_skill=True)
    ]
    if len(records) > HANDOFF_MAX_FILES:
        die(f"a handoff may contain at most {HANDOFF_MAX_FILES} files")
    if len({record["path"] for record in records}) != len(records):
        die("two handoff files resolve to the same bundle path")
    for record in records:
        if record["local_path"].stat().st_size > HANDOFF_MAX_FILE_BYTES:
            die(f"handoff file must be at most 10 MB: {record['local_path']}")
    if sum(record["local_path"].stat().st_size for record in records) > HANDOFF_MAX_TOTAL_BYTES:
        die("handoff files must total at most 25 MB")

    uploads = direct_upload_handoff_records(cfg, [record["local_path"] for record in records])
    files = [{
        "path": record["path"],
        "kind": record["kind"],
        "signed_id": upload["signed_id"],
        "sha256": handoff_sha256(record["local_path"]),
        "executable": os.access(record["local_path"], os.X_OK),
    } for record, upload in zip(records, uploads)]
    result = request(cfg, "POST", "/api/agent_handoffs", json_body={"agent_handoff": {
        "workspace_id": workspace,
        "source": args.source or handoff_source(),
        "title": args.title or handoff_path.stem.replace("_", " ").replace("-", " ").title() or "Agent handoff",
        "handoff_markdown": handoff_markdown,
        "files": files,
    }}, workspace=workspace)
    emit(result)
    if args.open:
        webbrowser.open(result["deep_link"])


# --------------------------------------------------------------------------
# commands — workspace landing page
# --------------------------------------------------------------------------
def cmd_landing_get(args, cfg):
    ws = resolve_workspace(cfg, args.workspace)
    if not ws:
        die("a workspace is required — pass --workspace or set WORKSPACE_ID")
    workspace = request(cfg, "GET", f"/workspaces/{ws}.json", workspace=ws)
    if args.html:
        sys.stdout.write((workspace.get("landing_page_html") or "") + "\n")
    else:
        emit(workspace)


def cmd_landing_set(args, cfg):
    ws = resolve_workspace(cfg, args.workspace)
    if not ws:
        die("a workspace is required — pass --workspace or set WORKSPACE_ID")
    # Send as a JSON body, not a multipart field. A multipart `@file` part is
    # parsed server-side as an ActionDispatch::Http::UploadedFile, and assigning
    # that to the string column stores its literal inspect string instead of the
    # HTML. JSON keeps landing_page_html unambiguously a string.
    if args.brief:
        workspace = {"brief": args.brief}
    else:
        if not Path(args.html_file).is_file():
            die(f"file not found: {args.html_file}")
        workspace = {"landing_page_html": Path(args.html_file).read_text(encoding="utf-8")}
    emit(request(cfg, "PATCH", f"/workspaces/{ws}.json",
                 json_body={"workspace": workspace}, workspace=ws))


# --------------------------------------------------------------------------
# commands — cache (local snapshot of tunes/prompts/packs/user)
# --------------------------------------------------------------------------
CACHE_FIELDS = {
    "tunes": ("id", "title", "name", "orig_images"),
    "prompts": ("id", "text", "num_images", "images", "aspect_ratio", "resolution", "input_image", "input_video", "order_id"),
    "packs": ("id", "title", "slug", "main_class_name", "multiplier", "multiplier_api"),
    "user": ("usd_balance_mc", "email", "name", "purchased_plugin_at"),
}
CACHE_MAX_AGE = 86400


def cache_dir(cfg, override):
    ws = resolve_workspace(cfg, override) or "personal"
    slug = "".join(c if c.isalnum() or c in "_.-" else "_" for c in ws)
    root = Path(os.environ.get("ASTRIA_CACHE_DIR") or (Path.cwd() / ".cache"))
    return root / f"ws_{slug}"


# Indexed columns mirrored from the full record into the SQLite store. Each
# table also gets a `json` TEXT column holding the complete record. These are
# the columns `astria cache get/find/uses` query against — no API calls.
DB_COLUMNS = {
    "tunes": ("id", "name", "title"),
    "prompts": ("id", "text", "pack_id", "tune_id", "order_id", "num_images", "aspect_ratio", "resolution"),
    "packs": ("id", "title", "slug", "main_class_name"),
}
CACHE_DB_NAME = "cache.db"


def cache_fetch(cfg, resource, workspace, out_dir):
    """Fetch one resource, write its `<resource>.json` snapshot, and return the
    raw API data so the caller can also load it into the SQLite store."""
    endpoint = "/users" if resource == "user" else f"/{resource}"
    data = request(cfg, "GET", endpoint, workspace=workspace, no_workspace=(workspace is None))
    fields = CACHE_FIELDS[resource]
    if isinstance(data, list):
        shaped = [{k: row.get(k) for k in fields} for row in data]
    else:
        shaped = {k: data.get(k) for k in fields}
    (out_dir / f"{resource}.json").write_text(json.dumps(shaped, ensure_ascii=False, indent=2))
    return data


def cache_db_path(cfg, override):
    return cache_dir(cfg, override) / CACHE_DB_NAME


def open_cache_db(cfg, override, *, require=False):
    """Open the local cache SQLite DB. With require=True, die() if it is missing
    so query commands point the user at `astria cache refresh`."""
    path = cache_db_path(cfg, override)
    if require and not path.is_file():
        die(f"no local cache at {path} — run `astria cache refresh` first")
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn


def db_init_schema(conn):
    """(Re)create the tunes/prompts/packs tables and their indexes."""
    for table, columns in DB_COLUMNS.items():
        conn.execute(f"DROP TABLE IF EXISTS {table}")
        cols = ", ".join(f"{c} INTEGER PRIMARY KEY" if c == "id" else f"{c} TEXT" for c in columns)
        conn.execute(f"CREATE TABLE {table} ({cols}, json TEXT NOT NULL)")
        for col in columns:
            if col != "id":
                conn.execute(f"CREATE INDEX idx_{table}_{col} ON {table} ({col})")


def db_load_resource(conn, resource, data):
    """Replace one table's rows from raw API data (a list of records)."""
    columns = DB_COLUMNS[resource]
    conn.execute(f"DELETE FROM {resource}")
    rows = data if isinstance(data, list) else [data]
    placeholders = ", ".join(["?"] * (len(columns) + 1))
    conn.executemany(
        f"INSERT OR REPLACE INTO {resource} ({', '.join(columns)}, json) VALUES ({placeholders})",
        [tuple(row.get(c) for c in columns) + (json.dumps(row, ensure_ascii=False),) for row in rows],
    )


def cmd_cache(args, cfg):
    if args.action == "path":
        print(cache_dir(cfg, args.workspace))
        return
    if args.action == "get":
        cmd_cache_get(args, cfg)
        return
    if args.action == "find":
        cmd_cache_find(args, cfg)
        return
    if args.action == "uses":
        cmd_cache_uses(args, cfg)
        return
    if args.action == "stats":
        cmd_cache_stats(args, cfg)
        return

    # action == "refresh"
    workspace = resolve_workspace(cfg, args.workspace)
    out_dir = cache_dir(cfg, args.workspace)
    out_dir.mkdir(parents=True, exist_ok=True)
    stamp = out_dir / "_refreshed_at"

    if args.resource:
        data = cache_fetch(cfg, args.resource, workspace, out_dir)
        if args.resource in DB_COLUMNS:
            conn = open_cache_db(cfg, args.workspace)
            conn.execute(f"CREATE TABLE IF NOT EXISTS {args.resource} "
                         f"({', '.join(DB_COLUMNS[args.resource])}, json TEXT NOT NULL)")
            db_load_resource(conn, args.resource, data)
            conn.commit()
            conn.close()
        stamp.write_text(str(int(time.time())))
        print(f"refreshed {args.resource} → {out_dir}")
        return

    if not args.force and stamp.is_file():
        age = time.time() - int(stamp.read_text() or 0)
        if age < CACHE_MAX_AGE:
            print(f"cache fresh ({int(age)}s old) — {out_dir}")
            return

    errors = []
    fetched = {}

    def worker(resource):
        try:
            fetched[resource] = cache_fetch(cfg, resource, workspace, out_dir)
        except AstriaError as exc:
            errors.append(str(exc))

    threads = [threading.Thread(target=worker, args=(r,)) for r in CACHE_FIELDS]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    if errors:
        die("; ".join(errors))

    conn = open_cache_db(cfg, args.workspace)
    db_init_schema(conn)
    for resource in DB_COLUMNS:
        db_load_resource(conn, resource, fetched[resource])
    conn.commit()
    conn.close()

    stamp.write_text(str(int(time.time())))
    print(f"refreshed tunes, prompts, packs, user → {out_dir}")


def cmd_cache_get(args, cfg):
    conn = open_cache_db(cfg, args.workspace, require=True)
    row = conn.execute(f"SELECT json FROM {args.table} WHERE id = ?", (args.id,)).fetchone()
    conn.close()
    if row is None:
        die(f"no {args.table} record with id {args.id} in the local cache")
    emit(json.loads(row["json"]))


def cmd_cache_find(args, cfg):
    conn = open_cache_db(cfg, args.workspace, require=True)
    # filter -> (column, mode): 'eq' for exact match, 'like' for substring
    filters = {
        "tunes": {"name": ("name", "like"), "title": ("title", "like")},
        "prompts": {"pack_id": ("pack_id", "eq"), "tune_id": ("tune_id", "eq"), "order_id": ("order_id", "eq"),
                    "text": ("text", "like")},
        "packs": {"main_class": ("main_class_name", "like"), "title": ("title", "like")},
    }[args.table]
    clauses, params = [], []
    for arg_name, (column, mode) in filters.items():
        value = getattr(args, arg_name, None)
        if value is None:
            continue
        if mode == "like":
            clauses.append(f"{column} LIKE ?")
            params.append(f"%{value}%")
        else:
            clauses.append(f"{column} = ?")
            params.append(value)
    where = f" WHERE {' AND '.join(clauses)}" if clauses else ""
    rows = conn.execute(f"SELECT json FROM {args.table}{where} ORDER BY id DESC", params).fetchall()
    conn.close()
    emit([json.loads(r["json"]) for r in rows])


# Tunes are referenced inside prompt text via tokens like <faceid:1234:1> or
# <lora:1234:0.8> — the id is the first colon-separated field after the type.
TUNE_TOKEN_RE = re.compile(r"<[a-z0-9_]+:(\d+):[^>]*>", re.IGNORECASE)


def cmd_cache_uses(args, cfg):
    conn = open_cache_db(cfg, args.workspace, require=True)
    rows = conn.execute("SELECT json FROM prompts WHERE text LIKE ?",
                        (f"%{args.tune_id}%",)).fetchall()
    conn.close()
    target = str(args.tune_id)
    matches = [
        json.loads(r["json"]) for r in rows
        if target in TUNE_TOKEN_RE.findall(json.loads(r["json"]).get("text") or "")
    ]
    emit(matches)


def cmd_cache_stats(args, cfg):
    path = cache_db_path(cfg, args.workspace)
    if not path.is_file():
        die(f"no local cache at {path} — run `astria cache refresh` first")
    conn = open_cache_db(cfg, args.workspace, require=True)
    counts = {t: conn.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0] for t in DB_COLUMNS}
    conn.close()
    stamp = cache_dir(cfg, args.workspace) / "_refreshed_at"
    age = int(time.time() - int(stamp.read_text() or 0)) if stamp.is_file() else None
    emit({
        "db_path": str(path),
        "counts": counts,
        "refreshed_age_seconds": age,
        "stale": age is None or age > CACHE_MAX_AGE,
    })


# --------------------------------------------------------------------------
# commands — download prompt images
# --------------------------------------------------------------------------
# Asset extensions we recognise from a URL path; anything else falls back to .jpg.
DOWNLOAD_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".mp4", ".webm", ".mov"}
DOWNLOAD_WORKERS = 6


def asset_ext(url):
    """Derive a file extension from an asset URL's path, defaulting to .jpg."""
    path = url.split("?", 1)[0].split("#", 1)[0]
    ext = os.path.splitext(path)[1].lower()
    return ext if ext in DOWNLOAD_EXTS else ".jpg"


def collect_prompt_ids(args):
    """Gather prompt ids from positional args, --prompts-file and stdin.
    Deduped, original order preserved."""
    raw = list(args.ids or [])
    if args.prompts_file:
        if not Path(args.prompts_file).is_file():
            die(f"file not found: {args.prompts_file}")
        raw += Path(args.prompts_file).read_text().split()
    if not raw and not sys.stdin.isatty():
        raw += sys.stdin.read().split()
    seen, ids = set(), []
    for token in raw:
        token = token.strip()
        if token and token not in seen:
            seen.add(token)
            ids.append(token)
    return ids


def download_asset(url, dest):
    """Fetch one asset URL to dest with curl. Raises AstriaError on failure."""
    argv = ["curl", "-sSL", "--fail", "--max-time", "120", "-A", USER_AGENT, "-o", str(dest), url]
    try:
        proc = subprocess.run(argv, capture_output=True)
    except FileNotFoundError:
        die("`curl` not found on PATH — install curl")
    if proc.returncode != 0:
        raise AstriaError(proc.stderr.decode("utf-8", "replace").strip() or f"curl exit {proc.returncode}")


def cmd_download(args, cfg):
    ids = collect_prompt_ids(args)
    if not ids:
        die("no prompt ids — pass them as arguments, via --prompts-file, or on stdin")

    out_dir = Path(args.out)
    out_dir.mkdir(parents=True, exist_ok=True)

    results = {}

    def worker(prompt_id):
        entry = {"id": prompt_id, "images": 0, "saved": []}
        try:
            prompt = request(cfg, "GET", f"/prompts/{prompt_id}.json", workspace=args.workspace)
        except AstriaError as exc:
            entry["error"] = str(exc)
            results[prompt_id] = entry
            return
        urls = (prompt or {}).get("images") or []
        entry["images"] = len(urls)
        if not urls:
            entry["error"] = "no images yet"
            results[prompt_id] = entry
            return
        width = max(2, len(str(len(urls))))
        for idx, url in enumerate(urls):
            dest = out_dir / f"prompt-{prompt_id}-{idx:0{width}d}{asset_ext(url)}"
            try:
                download_asset(url, dest)
                entry["saved"].append(str(dest))
            except AstriaError as exc:
                entry.setdefault("errors", []).append(f"{url}: {exc}")
        if "errors" in entry and not entry["saved"]:
            entry["error"] = "; ".join(entry.pop("errors"))
        results[prompt_id] = entry

    pending = list(ids)
    lock = threading.Lock()

    def pump():
        while True:
            with lock:
                if not pending:
                    return
                prompt_id = pending.pop(0)
            worker(prompt_id)

    threads = [threading.Thread(target=pump) for _ in range(min(DOWNLOAD_WORKERS, len(ids)))]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()

    prompts = [results[pid] for pid in ids]
    emit({
        "out": str(out_dir),
        "prompts": prompts,
        "totals": {
            "prompts": len(prompts),
            "downloaded": sum(len(p["saved"]) for p in prompts),
            "failed": sum(1 for p in prompts if p.get("error")),
        },
    })


# --------------------------------------------------------------------------
# commands — raw API escape hatch
# --------------------------------------------------------------------------
def cmd_api(args, cfg):
    form = [tuple(item.split("=", 1)) for item in args.form or [] if "=" in item]
    uploaded = iter(direct_uploads(cfg, [value[1:] for _, value in form if value.startswith("@")]))
    form = [(key, next(uploaded) if value.startswith("@") else value) for key, value in form]
    query = [tuple(item.split("=", 1)) for item in args.query or [] if "=" in item]
    json_body = json.loads(args.data) if args.data else None
    result = request(cfg, args.method.upper(), args.path, query=query, form=form, json_body=json_body,
                     workspace=args.workspace)
    emit(result) if not isinstance(result, str) else sys.stdout.write(result + "\n")


# --------------------------------------------------------------------------
# hidden — SessionStart hook
# --------------------------------------------------------------------------
def cmd_session_hook(args, cfg):
    # Best-effort: keep the /cli/models id cache warm (daily refresh).
    record = load_models_cache()
    try:
        if models_cache_stale(record, cfg):
            record = fetch_models(cfg) or record
    except Exception:
        pass
    authed = bool(os.environ.get("ASTRIA_API_KEY") or os.environ.get("ASTRIA_AUTH_TOKEN") or cfg.get("api_key"))
    out = {"hookSpecificOutput": {"hookEventName": "SessionStart"}}
    context = []
    if not authed:
        context.append(
            "The Astria plugin is installed but not authenticated. If the user asks to do "
            "anything with Astria (generate images, manage tunes/packs), tell them to run "
            f"`astria login` first (API key at {login_hint(cfg)})."
        )
    skills_context = skills_upgrade_context(record)
    if skills_context:
        context.append(skills_context)
    if context:
        out["hookSpecificOutput"]["additionalContext"] = "\n\n".join(context)
    emit(out)


# --------------------------------------------------------------------------
# argument parser
# --------------------------------------------------------------------------
# --help enum text is built from the cached /cli/models record so usage
# strings track the live catalog — never hardcode model names or resolutions.
def image_model_help(rec, prefix="model name or tune id"):
    models = rec.get("models") or {}
    if not models:
        return f"{prefix}; see 'astria models --type image', omit for the platform default"
    names = ", ".join(
        f"{name} (default)" if meta.get("default") or name == rec.get("default") else name
        for name, meta in models.items())
    return f"{prefix} — {names}; omit for the default"


def music_model_help(rec):
    models = rec.get("music_models") or {}
    if not models:
        return "music model name or tune id; see 'astria models --type music', omit for the default"
    names = ", ".join(f"{name} (default)" if name == rec.get("default_music_model") else name for name in models)
    return f"music model name or tune id — {names}; omit for the default"


def lyrics_help(rec):
    base = ("song lyrics, using the model's section tags such as [Verse] and [Chorus]; "
            "omit to let the model write them")
    limits = [f"{name}: {meta['lyrics_length']['min']}-{meta['lyrics_length']['max']} chars"
              for name, meta in (rec.get("music_models") or {}).items()]
    return f"{base} — {'; '.join(limits)}" if limits else f"{base}; see 'astria models --type music' for lengths and tags"


def resolution_help(rec, noun="output resolution"):
    res = sorted({r for meta in (rec.get("models") or {}).values()
                  for r in (meta.get("resolutions") or [])})
    if not res:
        return f"{noun}; see 'astria models --type image' for per-model supported values"
    return (f"{noun}, model-dependent — " + ", ".join(res)
            + "; see 'astria models --type image' for each model's set")


def video_model_help(rec):
    families = rec.get("video_model_families") or {}
    if not families:
        return ("video model family, e.g. seedance25 (pick its resolution with --video-resolution); "
                "see 'astria models --type video' for the list, omit for the catalog default")
    return ("video model family (pick its resolution with --video-resolution; variant ids such as "
            "seedance25_720p also work) — " + ", ".join(families)
            + f"; omit for {rec.get('default_video_model_family') or 'the catalog default'}")


def video_resolution_help(rec):
    families = rec.get("video_model_families") or {}
    listed = [f"{name}: {'/'.join(meta['resolutions'])}" for name, meta in families.items() if meta.get("resolutions")]
    base = "output resolution for --video-model, e.g. 720p; omit for the family default"
    return f"{base} — {'; '.join(listed)}" if listed else f"{base}; see 'astria models --type video' for each family's set"


def video_capability_help(rec, flag, base):
    models = [name for name, meta in (rec.get("video_model_families") or {}).items()
              if meta.get(flag)]
    if not models:
        return base
    return f"{base}; supported by {', '.join(models)}"


def build_parser(models_record=None):
    models_record = (load_models_cache() or {}) if models_record is None else models_record
    parser = argparse.ArgumentParser(prog="astria", description="Astria API command-line client.")
    parser.add_argument("--profile", metavar="NAME",
                        help="config profile to use (also ASTRIA_PROFILE env); default: 'default'")
    parser.add_argument("-v", "--version", action="version", version=f"astria {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    # shared --workspace for API commands
    ws_parent = argparse.ArgumentParser(add_help=False)
    ws_parent.add_argument("-w", "--workspace", help="workspace id, 'all', or 'personal'")

    # auth
    p = sub.add_parser("login", help="store an API key in ~/.astria/config.json")
    p.add_argument("--api-key", help="API key (else prompted / read from stdin)")
    p.add_argument("--base-url", help="override API base URL")
    p.add_argument("--workspace", help="default workspace id")
    p.set_defaults(func=cmd_login)

    sub.add_parser("logout", help="remove stored credentials").set_defaults(func=cmd_logout)
    sub.add_parser("whoami", parents=[ws_parent], help="show the authenticated account").set_defaults(func=cmd_whoami)

    p = sub.add_parser("config", help="show or change config")
    p.add_argument("action", nargs="?", choices=["get", "set"], help="get (default) or set")
    p.add_argument("key", nargs="?", help="config key for `set`")
    p.add_argument("value", nargs="?", help="config value for `set`")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("models", help="list available image, video and music models (name -> tune id)")
    p.add_argument("--refresh", action="store_true", help="force a refresh from the server")
    p.add_argument("--type", choices=list(API_OPERATIONS["list_models"]["result"]["sections"]["keys"]),
                   help="only the image, video or music catalog; omit for all three")
    p.set_defaults(func=cmd_models)

    p = sub.add_parser("upgrade", help="upgrade this astria executable in place")
    p.add_argument("--url", help=argparse.SUPPRESS)
    p.add_argument("--path", help=argparse.SUPPRESS)
    p.add_argument("--force", action="store_true", help="install even if the downloaded version is not newer")
    p.set_defaults(func=cmd_upgrade)

    # tunes
    tunes = sub.add_parser("tunes", help="references / fine-tuned models").add_subparsers(dest="sub", required=True)
    p = tunes.add_parser("list", parents=[ws_parent], help="List image reference sets and trained models accessible to your Astria account")
    p.add_argument("--title", help="filter by title / product name / SKU substring")
    p.add_argument("--name", action="append", help="filter by class name (repeatable)")
    p.add_argument("--model-type", help="filter by model_type (e.g. faceid)")
    p.add_argument("--branch", help="filter by branch (e.g. partner-1 to discover partner models)")
    p.add_argument("--gallery", action="store_true", help="query the public gallery instead")
    p.add_argument("--limit")
    p.add_argument("--offset")
    p.set_defaults(func=cmd_tunes_list)
    p = tunes.add_parser("get", parents=[ws_parent], help="Get an Astria image reference set or trained model by ID, including details and image URLs")
    p.add_argument("id")
    p.set_defaults(func=cmd_tunes_get)
    p = tunes.add_parser("create", parents=[ws_parent], help="create a tune / reference")
    p.add_argument("--title", required=True)
    p.add_argument("--name", required=True, help="subject class (man, woman, dress, shoes, pose, ...)")
    p.add_argument("--model", default=None, help=image_model_help(models_record, "base model for the reference"))
    p.add_argument("--model-type", default="faceid")
    p.add_argument("--description", help="short description (stored in characteristics)")
    p.add_argument("--image-url", action="append", help="training image URL (repeatable)")
    p.add_argument("--image", action="append", help="local training image file (repeatable)")
    p.set_defaults(func=cmd_tunes_create)
    p = tunes.add_parser("update", parents=[ws_parent], help="update a tune")
    p.add_argument("id")
    p.add_argument("--title")
    p.add_argument("--name")
    p.add_argument("--description")
    p.add_argument("--sources", type=structured_argument("sources"), help="catalog provenance as a JSON array of source records")
    p.set_defaults(func=cmd_tunes_update)

    # prompts
    prompts = sub.add_parser("prompts", help="image/video generation records").add_subparsers(dest="sub", required=True)
    p = prompts.add_parser("list", parents=[ws_parent], help="list prompts")
    for name, spec in PROMPT_FILTERS.items():
        options = {"help": spec["help"]}
        if "choices" in spec:
            options["choices"] = spec["choices"]
        if spec["mode"] == "flag":
            options["action"] = "store_true"
        elif spec["mode"] == "boolean":
            options.update(action=argparse.BooleanOptionalAction, default=None)
        elif spec["mode"] == "array":
            options["action"] = "append"
        p.add_argument("--" + name.replace("_", "-"), **options)
    p.add_argument("--expand", action="append", choices=["debug_images", "prompt.debug_images", "comments", "prompt.comments"],
                   help="expand a prompt field, e.g. debug_images (repeatable)")
    p.set_defaults(func=cmd_prompts_list)
    p = prompts.add_parser("get", parents=[ws_parent], help="get one prompt")
    p.add_argument("id")
    p.add_argument("--tune", help="tune id the prompt belongs to")
    p.add_argument("--model", help="model name instead of --tune")
    p.add_argument("--expand", action="append", choices=["debug_images", "prompt.debug_images", "comments", "prompt.comments"],
                   help="expand a prompt field, e.g. debug_images (repeatable)")
    p.set_defaults(func=cmd_prompts_get)
    p = prompts.add_parser("update", parents=[ws_parent], help="update a prompt (assign pack / move workspace)")
    p.add_argument("id")
    p.add_argument("--tune", help="tune id the prompt belongs to")
    p.add_argument("--model", help="model name instead of --tune")
    p.add_argument("--pack-id", help="assign as a pack template prompt; use null to clear")
    p.add_argument("--base-pack-id", help="bind as a pack one-off")
    p.add_argument("--workspace-id")
    p.set_defaults(func=cmd_prompts_update)
    p = prompts.add_parser("wait", parents=[ws_parent],
                           help="block until one or more prompts have images or a user_error")
    p.add_argument("ids", nargs="*", help="prompt ids (also accepted via --prompts-file or stdin)")
    p.add_argument("--prompts-file", help="file of prompt ids (one per line or whitespace-separated)")
    p.add_argument("--timeout", type=int, default=WAIT_TIMEOUT_SEC,
                   help=f"total wall-clock cap in seconds (default: {WAIT_TIMEOUT_SEC})")
    p.add_argument("--interval", type=int, default=WAIT_INTERVAL_SEC,
                   help=f"polling interval in seconds (default: {WAIT_INTERVAL_SEC}, min {WAIT_INTERVAL_MIN})")
    p.set_defaults(func=cmd_prompts_wait)

    # generate
    p = sub.add_parser(
        "generate", parents=[ws_parent], help="generate images",
        formatter_class=argparse.RawTextHelpFormatter,
        epilog=(
            "examples:\n"
            "  astria generate --model wan-2-7 --text \"plain white background\" \\\n"
            "    --reference \"dress=./dress.jpg\" --reference \"woman=./woman.jpg\" --num-images 1 --wait"
        ),
    )
    p.add_argument("--model", default=None, help=image_model_help(models_record))
    p.add_argument("--text", help="prompt text; embed references as <faceid:ID:1>")
    p.add_argument("--video-prompt", help=argparse.SUPPRESS)
    p.add_argument("--num-images", help="override config default_num_images; otherwise 2, or 1 with --input-image")
    p.add_argument("--seed", help="generation seed; also makes an otherwise-identical prompt distinct")
    p.add_argument("--film-grain", "--film_grain", action=argparse.BooleanOptionalAction, default=None,
                   help="enable film-grain post-processing as a separate prompt attribute; "
                        "--film_grain is an alias")
    p.add_argument("--aspect-ratio", default="3:4", help="e.g. 3:4, 1:1, 16:9 (default: %(default)s)")
    p.add_argument("--resolution", help=resolution_help(models_record))
    p.add_argument("--input-image", help="URL or local file to edit")
    p.add_argument("--inpaint-faces", action=argparse.BooleanOptionalAction, default=None,
                   help="enable or disable face inpainting; omit to use the model default")
    p.add_argument("--mask-image", help="URL or local file to use as an inpainting mask")
    p.add_argument("--reference", "--images", dest="references", action="append", metavar="NAME=PATH_OR_URL",
                   help="create and attach a reference; repeat for each NAME=PATH_OR_URL (--images is an alias)")
    p.add_argument("--pack-id", help="author the prompt as a pack template prompt")
    p.add_argument("--base-pack-id", help="bind as a pack one-off")
    p.add_argument("--wait", action="store_true", help="block until images are ready")
    p.set_defaults(func=cmd_generate)

    # video
    p = sub.add_parser(
        "video", parents=[ws_parent], help="generate video",
        formatter_class=argparse.RawTextHelpFormatter,
        epilog=(
            "references use the same syntax as image prompts:\n"
            "  <faceid:TUNE_ID:1> TUNE_NAME\n"
            "The tune name must immediately follow its token. Put existing tune mentions in\n"
            "--video-prompt. --reference NAME=PATH_OR_URL creates a new reference and adds\n"
            "the correctly formatted mention to --text and --video-prompt automatically.\n\n"
            "examples:\n"
            "  # Existing reference tune\n"
            "  astria video --video-model seedance2_fast --video-resolution 720p \\\n"
            "    --video-prompt \"<faceid:1234:1> woman walks down a runway\" --duration 5 --wait\n\n"
            "  # Create and use references from local files or URLs\n"
            "  astria video --video-model seedance2_fast --video-resolution 480p \\\n"
            "    --video-prompt \"woman wearing dress, plain white background\" \\\n"
            "    --reference \"dress=./dress.jpg\" --reference \"woman=./woman.jpg\" \\\n"
            "    --num-images 1 --wait\n\n"
            "  # Attach ordered raw image references without creating tunes\n"
            "  astria video --video-model seedance2_fast --video-resolution 720p \\\n"
            "    --video-prompt \"transition through these looks in order\" \\\n"
            "    --image-reference ./look-1.jpg --image-reference ./look-2.jpg --wait"
        ),
    )
    p.add_argument("--model", default=None, help=image_model_help(models_record, "first-frame image model"))
    p.add_argument("--text", help="first-frame prompt text")
    p.add_argument("--video-model", help=video_model_help(models_record))
    p.add_argument("--video-resolution", help=video_resolution_help(models_record))
    p.add_argument("--video-prompt", required=True,
                   help="motion / action description; references use <faceid:TUNE_ID:1> TUNE_NAME")
    p.add_argument("--duration", help="seconds (model-dependent)")
    p.add_argument("--seed", help="generation seed; reuse a draft's seed to reproduce it at a higher resolution")
    p.add_argument("--aspect-ratio", default="3:4", help="e.g. 3:4, 1:1, 16:9 (default: %(default)s)")
    p.add_argument("--resolution", help=resolution_help(
        models_record, "first-frame image resolution (video resolution is set by --video-resolution)"))
    p.add_argument("--num-images", help="override config default_num_images; otherwise 2")
    p.add_argument("--input-image", help=argparse.SUPPRESS)
    p.add_argument("--reference", "--images", dest="references", action="append", metavar="NAME=PATH_OR_URL",
                   help="create and attach a reference; repeat for each NAME=PATH_OR_URL (--images is an alias)")
    p.add_argument("--image-reference", dest="image_references", action="append", metavar="PATH_OR_URL",
                   help=video_capability_help(
                       models_record, "supports_image_references",
                       "attach an ordered raw image reference; repeat for each image"))
    p.add_argument("--first-frame", help="URL or file overriding the rendered first frame")
    p.add_argument("--last-frame", help="URL or file for keyframe models")
    p.add_argument("--input-video", help="URL or file for motion-control models")
    p.add_argument("--audio-reference", help=video_capability_help(
        models_record, "supports_audio_reference",
        "URL or file — reference audio track the video is driven by"))
    p.add_argument("--generate-audio", action=argparse.BooleanOptionalAction, default=None,
                   help=video_capability_help(
                       models_record, "generates_audio",
                       "generate a soundtrack (picks the audio version of families that price it separately); omit for silent"))
    p.add_argument("--wait", action="store_true")
    p.set_defaults(func=cmd_video)

    # music
    p = sub.add_parser(
        "music", parents=[ws_parent], help="generate a song",
        formatter_class=argparse.RawTextHelpFormatter,
        epilog=(
            "examples:\n"
            "  # Song with your own lyrics\n"
            "  astria music \"upbeat synth-pop, female vocals, 120 bpm\" \\\n"
            "    --lyrics \"[Verse]\\nCity lights are calling\\n[Chorus]\\nWe run all night\" --wait\n\n"
            "  # Let the model write the lyrics, or make an instrumental\n"
            "  astria music \"melancholic indie folk about leaving home\"\n"
            "  astria music \"lo-fi hip hop beat for studying\" --instrumental"
        ),
    )
    p.add_argument("text", help="song description: genre, mood, instruments, vocals and tempo")
    p.add_argument("--model", default=None, help=music_model_help(models_record))
    p.add_argument("--lyrics", help=lyrics_help(models_record))
    p.add_argument("--instrumental", action="store_true", help="make a song without vocals; cannot be combined with lyrics")
    p.add_argument("--num-images", default="1", help="number of songs to generate (default: %(default)s)")
    p.add_argument("--wait", action="store_true", help="block until the song is ready")
    p.set_defaults(func=cmd_music)

    p = sub.add_parser(
        "variate", parents=[ws_parent],
        help="edit a source video while preserving its timing and performance",
        formatter_class=argparse.RawTextHelpFormatter,
        epilog=(
            "examples:\n"
            "  astria variate ./source.mp4 --brief 'Change the end card to Astria' --wait\n"
            "  astria variate ./source.mp4 --reference ./dress.jpg --reference woman=./model.jpg --wait\n"
            "  astria variate https://example.com/source.mp4 --tune-id 123 --brief 'Replace the presenter'"
        ),
    )
    p.add_argument("source", help="local MP4/MOV file or public HTTPS video URL")
    p.add_argument("--brief", default="", help="requested edit; optional when references are supplied")
    p.add_argument("--tune-id", dest="tune_ids", action="append", metavar="ID",
                   help="existing replacement reference (repeatable)")
    p.add_argument("--reference", dest="references", action="append", metavar="[NAME=]PATH_OR_URL",
                   help="create a replacement reference; omit NAME to auto-detect it (repeatable)")
    description = p.add_mutually_exclusive_group()
    description.add_argument("--description", help="source-video description; skips video inspection")
    description.add_argument("--description-file", help="read source-video description from a UTF-8 file")
    p.add_argument("--base-pack-id", type=int, help="bind the result as a pack one-off")
    p.add_argument("--order-id", type=int, help="associate the result with an accessible order")
    p.add_argument("--wait", action="store_true", help="block until the generated video is ready")
    p.set_defaults(func=cmd_variate)

    p = sub.add_parser("inspect-video", parents=[ws_parent],
                       help="describe a video as timestamped text-to-video prompt text")
    p.add_argument("source", help="local video file or public HTTPS URL")
    p.add_argument("--tune-id", action="append", metavar="ID",
                   help="reference whose appearance should be removed from the description (repeatable)")
    p.set_defaults(func=cmd_inspect_video)

    p = sub.add_parser("inspect", parents=[ws_parent],
                       help="describe an image as image-generation prompt text")
    p.add_argument("source", help="local image file or public HTTPS image URL")
    p.add_argument("--name", action="append",
                   help="reference name whose appearance should be removed from the description (repeatable)")
    p.set_defaults(func=cmd_inspect)

    # download — pull a prompt's rendered images/videos to a local directory
    p = sub.add_parser("download", parents=[ws_parent],
                       help="download the images/videos for one or more prompt ids")
    p.add_argument("ids", nargs="*", help="prompt ids (also accepted via --prompts-file or stdin)")
    p.add_argument("--out", default="./astria-downloads", help="target directory (created if missing)")
    p.add_argument("--prompts-file", help="file of prompt ids (one per line or whitespace-separated)")
    p.set_defaults(func=cmd_download)

    # packs
    packs = sub.add_parser("packs", help="prompt-template collections").add_subparsers(dest="sub", required=True)
    p = packs.add_parser("list", parents=[ws_parent], help="List reusable Astria photoshoot templates with their IDs and titles")
    p.add_argument("--limit")
    p.add_argument("--offset")
    p.set_defaults(func=cmd_packs_list)
    p = packs.add_parser("get", parents=[ws_parent], help="get a pack and its template prompts")
    p.add_argument("slug", help="pack slug or id")
    p.set_defaults(func=cmd_packs_get)
    p = packs.add_parser("create", parents=[ws_parent], help="create a pack")
    p.add_argument("--title", required=True)
    p.add_argument("--subtitle")
    p.add_argument("--model", default=None, help=image_model_help(models_record, "base model for the pack"))
    p.add_argument("--model-type", default="faceid")
    p.add_argument("--main-class-name", help="swappable product category")
    p.set_defaults(func=cmd_packs_create)
    p = packs.add_parser("update", parents=[ws_parent], help="update a template's title and reference categories")
    p.add_argument("id")
    p.add_argument("--title")
    p.add_argument("--subtitle")
    p.add_argument("--main-class-name")
    p.add_argument("--reference-class-name", dest="reference_class_names", action="append")
    p.set_defaults(func=cmd_packs_update)
    p = packs.add_parser(
        "run", parents=[ws_parent],
        formatter_class=argparse.RawTextHelpFormatter,
        help="run a pack (template): fire its prompts against tunes (or a fresh training set)",
        epilog=(
            "examples:\n"
            "  # multi pack — run against existing tunes, with overrides\n"
            "  astria packs run spring-lookbook --tune-id 123 --tune-id 456 \\\n"
            "    --brief \"golden hour, Lisbon\" --aspect-ratio 3:4 --inpaint-faces\n"
            "  # only a subset of the pack's template prompts\n"
            "  astria packs run spring-lookbook --tune-id 123 --prompt-ids 501,502\n"
            "  # regular pack — train a fresh tune from photos, then generate\n"
            "  astria packs run my-pack --title Jane --name woman --image ./a.jpg --image ./b.jpg"
        ),
    )
    p.add_argument("slug", help="pack slug or id")
    p.add_argument("--tune-id", action="append", metavar="ID",
                   help="existing tune to run the pack against (repeatable; multi packs need >=1)")
    p.add_argument("--tune-replacements", type=structured_argument("tune_replacements"), help="JSON object mapping original reference IDs to arrays of replacement IDs; other template references remain fixed")
    p.add_argument("--prompt-ids", help="subset of the pack's template prompt ids, comma-separated")
    p.add_argument("--brief", help="art-direction brief applied to the generated prompts")
    p.add_argument("--title", help="[train] tune title, e.g. the subject's name")
    p.add_argument("--name", help="[train] subject class: man, woman, dress, shoes, ...")
    p.add_argument("--image", action="append", metavar="FILE", help="[train] local image (repeatable)")
    p.add_argument("--image-url", action="append", metavar="URL", help="[train] remote image (repeatable)")
    p.add_argument("--num-images", help="override: images per prompt")
    p.add_argument("--aspect-ratio", help="override: e.g. 3:4, 1:1, 16:9")
    p.add_argument("--resolution", help="override: e.g. 1K, 2K")
    p.add_argument("--inpaint-faces", action=argparse.BooleanOptionalAction, default=None,
                   help="override: face inpainting on/off")
    p.add_argument("--attr", action="append", metavar="KEY=VALUE",
                   help="any other prompt attribute override (repeatable), e.g. --attr super_resolution=true")
    p.set_defaults(func=cmd_packs_run)

    # workspaces
    workspaces = sub.add_parser("workspaces", help="workspaces").add_subparsers(dest="sub", required=True)
    wl = workspaces.add_parser("list", help="list workspaces")
    wl.add_argument("--expand", action="append", choices=["migration"], help="include website URLs for migration lookup")
    wl.set_defaults(func=cmd_workspaces_list)
    wg = workspaces.add_parser("get", parents=[ws_parent], help="inspect a workspace")
    wg.add_argument("id")
    wg.set_defaults(func=cmd_workspaces_get)
    wc = workspaces.add_parser("create", help="create a workspace")
    wc.add_argument("--title", required=True)
    wc.add_argument("--url", help="canonical brand website URL")
    wc.set_defaults(func=cmd_workspaces_create)
    wu = workspaces.add_parser("update", parents=[ws_parent], help="update brand workspace metadata or landing page HTML")
    wu.add_argument("id")
    wu.add_argument("--title")
    wu.add_argument("--url")
    wu.add_argument("--landing-page-html")
    wu.set_defaults(func=cmd_workspaces_update)

    # agent handoff
    agent = sub.add_parser("agent", help="Astria embedded agent").add_subparsers(dest="sub", required=True)
    p = agent.add_parser("handoff", parents=[ws_parent], help="hand work from another agent into Astria")
    p.add_argument("--handoff", required=True, metavar="HANDOFF.md", help="UTF-8 handoff summary")
    p.add_argument("--attach", action="append", metavar="PATH", help="attach a file or directory (repeatable)")
    p.add_argument("--skill", action="append", metavar="DIR", help="include a skill directory containing SKILL.md (repeatable)")
    p.add_argument("--source", choices=["chatgpt", "claude-code", "claude-desktop", "cursor", "other"])
    p.add_argument("--title", help="title for the imported Astria chat")
    p.add_argument("--open", action="store_true", help="open the Astria deep link after upload")
    p.set_defaults(func=cmd_agent_handoff)

    # landing page
    landing = sub.add_parser("landing", help="workspace landing page").add_subparsers(dest="sub", required=True)
    p = landing.add_parser("get", parents=[ws_parent], help="fetch the workspace JSON (incl. landing_page_html)")
    p.add_argument("--html", action="store_true", help="print only landing_page_html (raw)")
    p.set_defaults(func=cmd_landing_get)
    p = landing.add_parser("set", parents=[ws_parent], help="update the landing page")
    p.add_argument("--html-file", help="path to the edited inner-body HTML")
    p.add_argument("--brief", help="regenerate the whole page from this brief (Gemini)")
    p.set_defaults(func=cmd_landing_set)

    # cache — local snapshot (JSON + SQLite) of tunes/prompts/packs/user.
    # Query subcommands (get/find/uses/stats) read ONLY the local DB, never the API.
    cache = sub.add_parser("cache", parents=[ws_parent],
                           help="local snapshot + query layer for tunes/prompts/packs")
    cache_sub = cache.add_subparsers(dest="action")
    cache.set_defaults(action="refresh", resource=None, force=False, func=cmd_cache)

    p = cache_sub.add_parser("refresh", parents=[ws_parent],
                             help="pull tunes/prompts/packs/user into JSON + SQLite")
    p.add_argument("resource", nargs="?", choices=list(CACHE_FIELDS), help="refresh only one resource")
    p.add_argument("--force", action="store_true", help="refresh even if the cache is fresh")
    p.set_defaults(func=cmd_cache)

    p = cache_sub.add_parser("path", parents=[ws_parent], help="print the cache directory")
    p.set_defaults(func=cmd_cache, resource=None, force=False)

    p = cache_sub.add_parser("get", parents=[ws_parent], help="get one cached record by id (local DB)")
    p.add_argument("table", choices=list(DB_COLUMNS), help="tunes / prompts / packs")
    p.add_argument("id", help="record id")
    p.set_defaults(func=cmd_cache, resource=None, force=False)

    p = cache_sub.add_parser("find", parents=[ws_parent], help="filter cached records (local DB)")
    find_sub = p.add_subparsers(dest="table", required=True)
    f = find_sub.add_parser("tunes", parents=[ws_parent], help="find tunes by name / title substring")
    f.add_argument("--name", help="class-name substring filter")
    f.add_argument("--title", help="title substring filter")
    f.set_defaults(func=cmd_cache, action="find", resource=None, force=False)
    f = find_sub.add_parser("prompts", parents=[ws_parent], help="find prompts by pack / tune / text")
    f.add_argument("--pack-id", dest="pack_id", help="exact pack id")
    f.add_argument("--tune-id", dest="tune_id", help="exact tune id")
    f.add_argument("--order-id", dest="order_id", help="exact order id")
    f.add_argument("--text", help="prompt text substring filter")
    f.set_defaults(func=cmd_cache, action="find", resource=None, force=False)
    f = find_sub.add_parser("packs", parents=[ws_parent], help="find packs by main-class / title")
    f.add_argument("--main-class", dest="main_class", help="main_class_name substring filter")
    f.add_argument("--title", help="title substring filter")
    f.set_defaults(func=cmd_cache, action="find", resource=None, force=False)

    p = cache_sub.add_parser("uses", parents=[ws_parent],
                             help="prompts whose text references a tune id (<faceid:ID:..>)")
    p.add_argument("tune_id", help="tune id to cross-reference")
    p.set_defaults(func=cmd_cache, resource=None, force=False)

    p = cache_sub.add_parser("stats", parents=[ws_parent], help="row counts per table + cache age")
    p.set_defaults(func=cmd_cache, resource=None, force=False)

    # raw api
    p = sub.add_parser("api", parents=[ws_parent], help="raw API call (escape hatch)")
    p.add_argument("method", help="GET / POST / PATCH / DELETE")
    p.add_argument("path", help="API path, e.g. /tunes?limit=5")
    p.add_argument("--query", action="append", help="query param k=v (repeatable)")
    p.add_argument("--form", action="append",
                   help="form field k=v (repeatable; @file values are direct-uploaded first)")
    p.add_argument("--data", help="raw JSON request body")
    p.set_defaults(func=cmd_api)

    # hidden hook
    p = sub.add_parser("_session-hook")
    p.set_defaults(func=cmd_session_hook)

    return parser



# The command tree above is the parameter source of truth for CLI and MCP.
# Only transport policy lives here; no second set of API payload builders.
OPERATION_POLICIES = {
    "list_models": (("models",), True, {"refresh"}),
    "list_workspaces": (("workspaces", "list"), True, set()),
    "list_references": (("tunes", "list"), True, set()),
    "get_reference": (("tunes", "get"), True, set()),
    "update_reference": (("tunes", "update"), False, set()),
    "create_reference": (("tunes", "create"), False, {"image"}),
    "generate_images": (("generate",), False, {"wait", "video_prompt"}),
    "generate_video": (("video",), False, {"wait", "input_image"}),
    "generate_music": (("music",), False, {"wait"}),
    "list_prompts": (("prompts", "list"), True, set()),
    "get_prompt": (("prompts", "get"), True, set()),
    "update_prompt": (("prompts", "update"), False, set()),
    "list_templates": (("packs", "list"), True, set()),
    "get_template": (("packs", "get"), True, set()),
    "create_template": (("packs", "create"), False, set()),
    "update_template": (("packs", "update"), False, set()),
    "create_workspace": (("workspaces", "create"), False, set()),
    "get_workspace": (("workspaces", "get"), True, set()),
    "update_workspace": (("workspaces", "update"), False, set()),
    "run_template": (("packs", "run"), False, {"image", "attr"}),
}
CLI_ONLY_COMMANDS = {
    ("login",): "Host-local credential storage", ("logout",): "Host-local credential removal",
    ("whoami",): "MCP exposes authenticated get_profile separately", ("config",): "Host-local configuration",
    ("upgrade",): "Installs the local executable", ("prompts", "wait"): "Blocking local polling; MCP uses get_prompt/events",
    ("variate",): "Multi-stage inspection/generation workflow not yet exported",
    ("inspect-video",): "Blocking inspection workflow not yet exported", ("inspect",): "Inspection not yet exported",
    ("download",): "Writes local files", ("agent", "handoff"): "Embedded-agent session handoff",
    ("landing", "get"): "Local HTML extraction; MCP get_workspace returns metadata",
    ("landing", "set"): "Local-file input; MCP update_workspace accepts supplied HTML",
    ("cache", "refresh"): "Local cache", ("cache", "path"): "Local cache",
    ("cache", "get"): "Local cache", ("cache", "find", "tunes"): "Local cache",
    ("cache", "find", "prompts"): "Local cache", ("cache", "find", "packs"): "Local cache",
    ("cache", "uses"): "Local cache", ("cache", "stats"): "Local cache",
    ("api",): "Unrestricted raw API escape hatch is CLI-only", ("_session-hook",): "Local agent hook",
}


def command_paths(parser, prefix=()):
    subparsers = [action for action in parser._actions if isinstance(action, argparse._SubParsersAction)]
    if not subparsers:
        return {prefix}
    return set().union(*(command_paths(child, prefix + (name,))
        for action in subparsers for name, child in action.choices.items()))


def validate_operation_coverage():
    commands = command_paths(build_parser(models_record={}))
    exposed = {path for path, _readonly, _excluded in OPERATION_POLICIES.values()}
    excluded = set(CLI_ONLY_COMMANDS)
    if exposed & excluded or commands != exposed | excluded:
        raise AstriaError(f"CLI/MCP coverage mismatch: unclassified={sorted(commands - exposed - excluded)}, "
            f"stale={sorted((exposed | excluded) - commands)}, duplicate={sorted(exposed & excluded)}")

